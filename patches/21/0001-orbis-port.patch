+#!/usr/bin/env python3
+"""Run the actual internal OS dispatcher with Orbis-generated platform constants."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+jdk = Path(sys.argv[1]).resolve()
+with tempfile.TemporaryDirectory(prefix='jdk21-orbis-os-') as name:
+    temp = Path(name)
+    source = temp / 'src/jdk/internal/util'
+    source.mkdir(parents=True)
+    template = (root / 'src/java.base/share/classes/jdk/internal/util/PlatformProps.java.template').read_text()
+    for key, value in {'OPENJDK_TARGET_OS': 'orbis', 'OPENJDK_TARGET_CPU': 'x64',
+                       'OPENJDK_TARGET_CPU_BITS': '64', 'OPENJDK_TARGET_CPU_ENDIAN': 'little'}.items():
+        template = template.replace('@@' + key + '@@', value)
+    (source / 'PlatformProps.java').write_text(template)
+    (source / 'OperatingSystem.java').write_text((root / 'src/java.base/share/classes/jdk/internal/util/OperatingSystem.java').read_text())
+    classes = temp / 'classes'
+    subprocess.run([str(jdk / 'bin/javac'), '--patch-module', 'java.base=' + str(temp / 'src'),
+                    '-d', str(classes), *map(str, source.glob('*.java'))], check=True)
+    probe = temp / 'OrbisOS.java'
+    probe.write_text('''import jdk.internal.util.OperatingSystem;
+public class OrbisOS {
+    public static void main(String[] args) {
+        if (OperatingSystem.current() != OperatingSystem.BSD || !OperatingSystem.isBsd()
+            || OperatingSystem.isLinux() || OperatingSystem.isWindows()) {
+            throw new AssertionError("Orbis must dispatch to BSD Unix implementations");
+        }
+        System.out.println("PASS: Orbis internal OS dispatch");
+    }
+}
+''')
+    export = 'java.base/jdk.internal.util=ALL-UNNAMED'
+    subprocess.run([str(jdk / 'bin/javac'), '--patch-module', 'java.base=' + str(classes),
+                    '--add-exports', export, '-d', str(temp), str(probe)], check=True)
+    subprocess.run([str(jdk / 'bin/java'), '--patch-module', 'java.base=' + str(classes),
+                    '--add-exports', export, '-cp', str(temp), 'OrbisOS'], check=True)
diff --git a/test/orbis/test-type-info.py b/test/orbis/test-type-info.py
new file mode 100644
index 000000000..4e87a51ee
--- /dev/null
+++ b/test/orbis/test-type-info.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""C2's Type::_type_info is filled at PRX startup by Initialize_type_info() rather than a static table.
+Every Type::TYPES entry needs a row there, equal to upstream's reference table (kept under #if 0): JDK 21
+added Interfaces, InstKlassPtr and AryKlassPtr, and their missing rows left a class pointer's basic type
+zero - C2's first klass constant (String.charAt, at VM start on the PS4) hit ShouldNotReachHere."""
+from pathlib import Path
+import re
+import sys
+
+# The source tree to check (default: the one this test lives in).
+root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parents[2]
+header = (root / 'src/hotspot/share/opto/type.hpp').read_text()
+source = (root / 'src/hotspot/share/opto/type.cpp').read_text()
+
+enum = header[header.index('  enum TYPES {'):]
+enum = enum[:enum.index('lastype')]
+names = [m.group(1) for m in re.finditer(r'^\s+(\w+)(?:=\d+)?,', enum, re.M)]
+assert names[0] == 'Bad' and names[-1] == 'Bottom', names
+
+init = source[source.index('void Type::Initialize_type_info()'):source.index('#undef SET_TYPE_INFO')]
+x86 = re.sub(r'#if defined\(PPC64\) \|\| defined\(S390\).*?#else', '', init, flags=re.S)
+rows = {}
+for m in re.finditer(r'SET_TYPE_INFO\((\w+),\s*(.*?)\);', x86):
+    assert m.group(1) not in rows, 'duplicate row ' + m.group(1)
+    rows[m.group(1)] = [part.strip() for part in m.group(2).split(',')]
+
+reference = source[source.index('#if 0 // Retained as the reference table'):]
+reference = reference[:reference.index('};')]
+reference = re.sub(r'#if defined\(PPC64\).*?#else', '', reference, flags=re.S)
+expected = {}
+for m in re.finditer(r'\{\s*(.*?)\s*\},?\s*//\s*(\w+)', reference):
+    expected[m.group(2)] = [part.strip() for part in m.group(1).split(',')]
+
+missing = [n for n in names if n not in rows]
+assert not missing, 'Initialize_type_info lacks rows for ' + ', '.join(missing)
+extra = [n for n in rows if n not in names]
+assert not extra, 'rows for unknown types ' + ', '.join(extra)
+differ = []
+for name in names:
+    assert name in expected, 'reference table lacks ' + name
+    if rows[name] != expected[name]:
+        differ.append(f'{name}: {rows[name]} != reference {expected[name]}')
+assert not differ, 'rows differ from the reference table:\n  ' + '\n  '.join(differ)
+print(f'PASS: C2 type info rows for all {len(names)} types match the reference table')
