+static const size_t TLS_SLOTS = 4096;          // power of two
+static const uintptr_t TLS_EMPTY = 0;
+static const uintptr_t TLS_TOMBSTONE = 1;
+static const uintptr_t TLS_CLAIMING = 2;       // being filled in by the thread that claimed it
