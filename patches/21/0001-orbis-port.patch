+_Static_assert(offsetof(OrbisNativeStat, mode) == 8, "Orbis st_mode ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, nlink) == 10, "Orbis st_nlink ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, uid) == 12, "Orbis st_uid ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, gid) == 16, "Orbis st_gid ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, rdev) == 20, "Orbis st_rdev ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, atim) == 24, "Orbis st_atim ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, mtim) == 40, "Orbis st_mtim ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, ctim) == 56, "Orbis st_ctim ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, size) == 72, "Orbis st_size ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, blocks) == 80, "Orbis st_blocks ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, blksize) == 88, "Orbis st_blksize ABI offset");
+_Static_assert(offsetof(OrbisNativeStat, flags) == 92, "Orbis st_flags ABI offset");
