new file mode 100644
index 000000000..2dee0131e
--- /dev/null
+++ b/src/java.base/unix/native/libjava/orbis_fs.h
@@ -0,0 +1,110 @@
+/*
+ * Copyright (c) 2026, Oracle and/or its affiliates. All rights reserved.
+ * ORACLE PROPRIETARY/CONFIDENTIAL. Use is subject to license terms.
+ */
+
+#ifndef ORBIS_FS_H
+#define ORBIS_FS_H
+
+#if defined(ORBIS)
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+#include "orbis_io.h"
+
+/*
+ * FreeBSD 9 / PS4 payload SDK sys/mount.h ABI, not the OpenOrbis libc
+ * statvfs ABI.  Toolchain statvfs does not copy its output to the caller;
+ * its statfs wrapper also returns an fd rather than the fstatfs result.
+ * Use the kernel import directly and keep the whole 472-byte output buffer native.
+ */
+typedef struct OrbisNativeStatFS {
+    uint32_t version;
+    uint32_t type;
+    uint64_t flags;
+    uint64_t bsize;
+    uint64_t iosize;
+    uint64_t blocks;
+    uint64_t bfree;
+    int64_t bavail;
+    uint64_t files;
+    int64_t ffree;
+    uint64_t syncwrites;
+    uint64_t asyncwrites;
+    uint64_t syncreads;
+    uint64_t asyncreads;
+    uint64_t spare[10];
+    uint32_t namemax;
+    uint32_t owner;
+    int32_t fsid[2];
+    char charspare[80];
+    char fstypename[16];
+    char mntfromname[88];
+    char mntonname[88];
+} OrbisNativeStatFS;
+
+_Static_assert(sizeof(OrbisNativeStatFS) == 472, "Orbis statfs ABI size");
+_Static_assert(offsetof(OrbisNativeStatFS, bsize) == 16, "Orbis f_bsize ABI offset");
+_Static_assert(offsetof(OrbisNativeStatFS, blocks) == 32, "Orbis f_blocks ABI offset");
+_Static_assert(offsetof(OrbisNativeStatFS, bfree) == 40, "Orbis f_bfree ABI offset");
+_Static_assert(offsetof(OrbisNativeStatFS, bavail) == 48, "Orbis f_bavail ABI offset");
+_Static_assert(offsetof(OrbisNativeStatFS, fsid) == 192, "Orbis f_fsid ABI offset");
+_Static_assert(offsetof(OrbisNativeStatFS, mntonname) == 384, "Orbis mount name ABI offset");
+
+extern int orbis_kernel_fstatfs(int fd, OrbisNativeStatFS *attributes)
+        __asm__("_fstatfs");
+
+static inline int orbis_statfs_path(JNIEnv *env, const char *path,
+                                    OrbisNativeStatFS *attributes) {
+    char resolved[PATH_MAX + 1];
+    const char *native_path = orbis_resolve_path(env, path, resolved,
+                                                sizeof(resolved));
+    if (native_path == NULL)
+        return -1;
+
+    int fd;
+    do {
+        fd = open(native_path, O_RDONLY);
+    } while (fd == -1 && errno == EINTR);
+    if (fd == -1)
+        return -1;
+
+    memset(attributes, 0, sizeof(*attributes));
+    int result;
+    do {
+        result = orbis_kernel_fstatfs(fd, attributes);
+    } while (result == -1 && errno == EINTR);
+    int saved_errno = errno;
+    /* Do not retry close: an interrupted close may already have released fd. */
+    close(fd);
+    errno = saved_errno;
+    if (result != 0) {
+        if (result != -1)
+            errno = EIO;
+        return -1;
+    }
+
+    /* Negative available blocks mean no space for an unprivileged caller. */
+    if (attributes->bavail < 0)
+        attributes->bavail = 0;
+    if (attributes->version != 0x20030518 || attributes->bsize == 0 ||
+        attributes->bfree > attributes->blocks ||
+        (uint64_t)attributes->bavail > attributes->bfree) {
+        errno = EIO;
+        return -1;
+    }
+    /* Reject unrepresentable byte counts instead of wrapping or inventing totals. */
+    if (attributes->bsize > INT64_MAX ||
+        attributes->blocks > (uint64_t)INT64_MAX / attributes->bsize) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+    return 0;
+}
+
+#endif /* ORBIS */
+#endif /* ORBIS_FS_H */
