--- /dev/null
+++ b/test/orbis/test-zip-descriptor-budget.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Run the migrated ZipFile on the host with a two-descriptor budget."""
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+root = Path(__file__).resolve().parents[2]
+jdk = Path(sys.argv[1]).resolve()
+probe = r'''
+import java.nio.file.*;
+import java.util.*;
+import java.util.zip.*;
+public class ZipBudgetProbe {
+    public static void main(String[] args) throws Exception {
+        Path dir = Path.of(args[0]);
+        List<ZipFile> files = new ArrayList<>();
+        try {
+            for (int i=0; i<6; i++) {
+                Path path = dir.resolve("archive" + i + ".zip");
+                try (var out = new ZipOutputStream(Files.newOutputStream(path))) {
+                    out.putNextEntry(new ZipEntry("payload"));
+                    out.write(("value" + i).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+                    out.closeEntry();
+                }
+                files.add(new ZipFile(path.toFile()));
+            }
+            for (int round=0; round<4; round++) {
+                for (int i=0; i<files.size(); i++) {
+                    ZipFile zip = files.get(i);
+                    try (var in = zip.getInputStream(zip.getEntry("payload"))) {
+                        String text = new String(in.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8);
+                        if (!text.equals("value" + i)) throw new AssertionError(text);
+                    }
+                }
+            }
+            // This checks actual descriptor eviction, not merely successful reads.
+            int open = 0;
+            try (var fds = Files.list(Path.of("/proc/self/fd"))) {
+                for (Path fd : fds.toList()) {
+                    try {
+                        if (Files.readSymbolicLink(fd).startsWith(dir)) open++;
+                    } catch (NoSuchFileException raced) { }
+                }
+            }
+            if (open > 2) throw new AssertionError("budget exceeded: " + open);
+            Files.write(dir.resolve("archive0.zip"), new byte[]{0}, StandardOpenOption.APPEND);
+            ZipFile old = files.get(0);
+            try (var in = old.getInputStream(old.getEntry("payload"))) {
+                in.readAllBytes();
+                throw new AssertionError("modified archive reopened without validation");
+            } catch (ZipException expected) {
+                if (!expected.getMessage().contains("changed")) throw expected;
+            }
+        } finally {
+            for (ZipFile zip : files) zip.close();
+        }
+        System.out.println("Zip descriptor eviction, reopen reads and changed-file rejection pass");
+    }
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    path = Path(tmp)
+    source = path / 'source/java/util/zip/ZipFile.java'
+    source.parent.mkdir(parents=True)
+    shutil.copy2(root / 'src/java.base/share/classes/java/util/zip/ZipFile.java', source)
+    patch = path / 'patch'
+    subprocess.run([str(jdk/'bin/javac'), '--patch-module', 'java.base='+str(path/'source'), '-d', str(patch), str(source)], check=True)
+    (path/'ZipBudgetProbe.java').write_text(probe)
+    subprocess.run([str(jdk/'bin/javac'), '-d', str(path), str(path/'ZipBudgetProbe.java')], check=True)
+    archives = path/'archives'; archives.mkdir()
+    subprocess.run([str(jdk/'bin/java'), '--patch-module', 'java.base='+str(patch), '-Djdk.zip.maxOpenFiles=2', '-cp', str(path), 'ZipBudgetProbe', str(archives)], check=True)
