+// To install functions for atexit system call
+extern "C" {
+  static void perfMemory_exit_helper() {
+    perfMemory_exit();
+  }
+}
+
+#if defined(ORBIS)
+// The SDK header declares this with a by-value size_t; libkernel writes the size through a pointer.
+extern "C" int32_t orbis_available_flexible_memory(size_t* size)
+    __asm__("sceKernelAvailableFlexibleMemorySize");
+// Likewise: the SDK declares the two outputs as values.
+extern "C" int32_t orbis_available_direct_memory(off_t start, off_t end, size_t alignment,
+                                                 off_t* found_start, size_t* found_size)
+    __asm__("sceKernelAvailableDirectMemorySize");
+
+// Anonymous mmap commits (card tables, mark bitmaps, metaspace) and native thread stacks share
+// the process's flexible-memory budget, which is far smaller than its direct memory. Logged under
+// -Xlog:os every 2 s whenever it moves by at least 1 MiB or 16 mappings, so a run shows its headroom.
+// The number of separate mappings in the process: Orbis refuses new mappings (thread stacks
+// included, which then fail with EAGAIN) once a process has accumulated too many, whatever
+// memory is left.
+static int orbis_count_mappings(bool list = false) {
+  OrbisKernelVirtualQueryInfo info;
+  const char* addr = NULL;
+  int count = 0;
+  while (count < 1000000 &&
+         sceKernelVirtualQuery(addr, 1 /* find next */, &info, sizeof(info)) == 0) {
+    ++count;
+    if (list) {
+      char name[33];
+      memcpy(name, info.name, 32);
+      name[32] = '\0';
+      log_info(os)("Orbis mapping " PTR_FORMAT "-" PTR_FORMAT " " SIZE_FORMAT "K%s%s%s%s%s %s",
+                   p2i(info.unk01), p2i(info.unk02), ((uintptr_t)info.unk02 - (uintptr_t)info.unk01) / K,
+                   info.isFlexibleMemory ? " flex" : "", info.isDirectMemory ? " direct" : "",
+                   info.isStack ? " stack" : "", info.isPooledMemory ? " pooled" : "",
+                   info.isCommitted ? " committed" : "", name);
+    }
+    // The SDK names the range start and end unk01 and unk02.
+    if ((uintptr_t)info.unk02 <= (uintptr_t)addr) break;
+    addr = (const char*)info.unk02;
+  }
+  return count;
+}
+
+extern volatile uint64_t orbis_platform_mutex_inits;
+extern volatile uint64_t orbis_platform_mutex_destroys;
+extern volatile uint64_t orbis_platform_cond_inits;
+extern volatile uint64_t orbis_platform_cond_destroys;
+extern address orbis_mutex_samples[256][4];
+extern volatile uint32_t orbis_mutex_sample_count;
+
+static void* orbis_probe_thread_entry(void*) { return NULL; }
+
+// Whether libkernel can still create a thread with default attributes, as Mesa and the runner's
+// input service do; returns pthread_create's result.
+static int orbis_probe_native_thread(size_t stack_size) {
+  pthread_attr_t attr;
+  pthread_attr_t* use = NULL;
+  if (stack_size != 0) {
+    if (pthread_attr_init(&attr) != 0) return -1;
+    pthread_attr_setstacksize(&attr, stack_size);
+    use = &attr;
+  }
+  pthread_t probe;
+  int result = pthread_create(&probe, use, orbis_probe_thread_entry, NULL);
+  if (result == 0) pthread_join(probe, NULL);
+  if (use != NULL) pthread_attr_destroy(&attr);
+  return result;
+}
+
+// The same creation through Sony's API, as orbis-compat does for Mesa: an attr object, a 2 MiB
+// stack and a name. Returns 0 or the SCE error code.
+static int orbis_probe_sce_thread() {
+  OrbisPthreadAttr attr;
+  int result = scePthreadAttrInit(&attr);
+  if (result != 0) return result;
+  scePthreadAttrSetstacksize(&attr, 2 * M);
+  OrbisPthread probe;
+  result = scePthreadCreate(&probe, &attr, orbis_probe_thread_entry, NULL, "orbis-probe");
+  if (result == 0) scePthreadJoin(probe, NULL);
+  scePthreadAttrDestroy(&attr);
+  return result;
+}
+
+// libkernel's internal pool backs every pthread mutex, condvar, attr and thread. Its headroom,
+// in mutexes, up to a cap that keeps the measurement itself from emptying it.
+static const int ORBIS_POOL_PROBE_CAP = 4096;
+static pthread_mutex_t orbis_pool_probe[ORBIS_POOL_PROBE_CAP];
+static int orbis_probe_pool_headroom() {
+  int n = 0;
+  while (n < ORBIS_POOL_PROBE_CAP && pthread_mutex_init(&orbis_pool_probe[n], NULL) == 0) {
+    n++;
+  }
+  for (int i = 0; i < n; i++) {
+    pthread_mutex_destroy(&orbis_pool_probe[i]);
+  }
+  return n;
+}
+
+// How many more threads the process can create right now: up to 64 parked threads are created,
+// counted, released and joined. Mesa's creation fails process-wide with brief openings, the
+// pattern of a process sitting at a thread limit.
+static const int ORBIS_THREAD_PROBE_CAP = 64;
+static pthread_mutex_t orbis_thread_probe_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t orbis_thread_probe_release = PTHREAD_COND_INITIALIZER;
+static bool orbis_thread_probe_go = false;
+
+static void* orbis_parked_probe_entry(void*) {
+  pthread_mutex_lock(&orbis_thread_probe_lock);
+  while (!orbis_thread_probe_go) pthread_cond_wait(&orbis_thread_probe_release, &orbis_thread_probe_lock);
+  pthread_mutex_unlock(&orbis_thread_probe_lock);
+  return NULL;
+}
+
+static int orbis_probe_thread_headroom(int* first_error) {
+  static pthread_t threads[ORBIS_THREAD_PROBE_CAP];
+  pthread_mutex_lock(&orbis_thread_probe_lock);
+  orbis_thread_probe_go = false;
+  pthread_mutex_unlock(&orbis_thread_probe_lock);
+  int n = 0;
+  *first_error = 0;
+  while (n < ORBIS_THREAD_PROBE_CAP) {
+    int rc = pthread_create(&threads[n], NULL, orbis_parked_probe_entry, NULL);
+    if (rc != 0) { *first_error = rc; break; }
+    n++;
+  }
+  pthread_mutex_lock(&orbis_thread_probe_lock);
+  orbis_thread_probe_go = true;
+  pthread_cond_broadcast(&orbis_thread_probe_release);
+  pthread_mutex_unlock(&orbis_thread_probe_lock);
+  for (int i = 0; i < n; i++) pthread_join(threads[i], NULL);
+  return n;
+}
+
+// The largest fresh anonymous mapping that succeeds right now, in KiB (16 KiB steps, 512 MiB
+// cap). Under Parallel GC, mappings of 1 MiB and more began failing with EINVAL while small ones
+// and 312 MiB of flexible memory remained - which is what stops new thread stacks.
+static size_t orbis_largest_anon_kib(int* small_errno) {
+  void* small = ::mmap(NULL, 64 * K, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  *small_errno = small == MAP_FAILED ? errno : 0;
+  if (small != MAP_FAILED) ::munmap(small, 64 * K);
+  size_t lo = 0, hi = 512 * K / 16;   // units of 16 KiB
+  while (lo < hi) {
+    size_t mid = (lo + hi + 1) / 2;
+    void* p = ::mmap(NULL, mid * 16 * K, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p != MAP_FAILED) { ::munmap(p, mid * 16 * K); lo = mid; } else { hi = mid - 1; }
+  }
+  return lo * 16;
+}
+
+extern "C" int32_t orbis_map_flexible(void** addr, size_t len, int32_t prot, int32_t flags)
+    __asm__("sceKernelMapFlexibleMemory");
+extern "C" int32_t orbis_release_flexible(void* addr, size_t len) __asm__("sceKernelReleaseFlexibleMemory");
+
+// Five ways to get 2 MiB once large anonymous mappings fail, to separate placement (where the
+// kernel puts hint-less anonymous mappings) from a budget or physical-contiguity limit.
+static void orbis_explain_anon_failure() {
+  const size_t size = 2 * M;
+  char* const hint = (char*)0x400000000ULL;   // inside the free gap above the crowded region
+  void* p;
+  int e1, e2, e3, e4a, e4b, e5;
+  uintptr_t got2 = 0;
+  p = ::mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  e1 = p == MAP_FAILED ? errno : 0; if (p != MAP_FAILED) ::munmap(p, size);
+  p = ::mmap(hint, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  e2 = p == MAP_FAILED ? errno : 0; if (p != MAP_FAILED) { got2 = (uintptr_t)p; ::munmap(p, size); }
+  // FreeBSD's MAP_EXCL (fail rather than replace); the SDK's headers do not define it.
+  p = ::mmap(hint, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | 0x4000, -1, 0);
+  e3 = p == MAP_FAILED ? errno : 0; if (p != MAP_FAILED) ::munmap(p, size);
+  p = ::mmap(NULL, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  e4a = p == MAP_FAILED ? errno : 0; e4b = -1;
+  if (p != MAP_FAILED) {
+    e4b = ::mprotect(p, size, PROT_READ | PROT_WRITE) == 0 ? 0 : errno;
+    if (e4b == 0) ((volatile char*)p)[0] = 1;
+    ::munmap(p, size);
+  }
+  void* flex = NULL;
+  e5 = orbis_map_flexible(&flex, size, PROT_READ | PROT_WRITE, 0);
+  if (e5 == 0) orbis_release_flexible(flex, size);
+  log_info(os)("Orbis 2 MiB attempts: plain %s; hint 0x400000000 %s (got " PTR_FORMAT "); fixed there %s; "
+               "reserve %s then mprotect RW %s; sceKernelMapFlexibleMemory 0x%x",
+               os::errno_name(e1), os::errno_name(e2), got2, os::errno_name(e3),
+               os::errno_name(e4a), e4b < 0 ? "-" : os::errno_name(e4b), (unsigned)e5);
+}
+
+class OrbisFlexibleMemoryReporter : public PeriodicTask {
+  size_t _last;
+  int _last_mappings;
+  int _last_probe[3];
+ public:
+  OrbisFlexibleMemoryReporter() : PeriodicTask(2000), _last(0), _last_mappings(0) {
+    _last_probe[0] = _last_probe[1] = _last_probe[2] = -1;
+  }
+  static void report(size_t* last, int* last_mappings) {
+    size_t available = 0;
+    if (orbis_available_flexible_memory(&available) != 0) return;
+    int mappings = orbis_count_mappings();
+    // Once, past 800: list every mapping, to see what is approaching the process limit.
+    static bool listed = false;
+    if (mappings > 800 && !listed) {
+      listed = true;
+      log_info(os)("Orbis mappings past 800 (%d); listing them", mappings);
+      mappings = orbis_count_mappings(true);
+    }
+    size_t delta = available > *last ? available - *last : *last - available;
+    int mapping_delta = mappings > *last_mappings ? mappings - *last_mappings : *last_mappings - mappings;
+    if (*last != 0 && delta < M && mapping_delta < 16) return;
+    *last = available;
+    *last_mappings = mappings;
+    off_t direct_start = 0;
+    size_t direct_free = 0;
+    if (orbis_available_direct_memory(0, (off_t)sceKernelGetDirectMemorySize(), 16 * K,
+                                      &direct_start, &direct_free) != 0) {
+      direct_free = 0;
+    }
+    log_info(os)("Orbis flexible memory available: " SIZE_FORMAT " MiB, %d mappings, largest free direct block "
+                 SIZE_FORMAT " MiB; HotSpot pthread mutexes %" PRIu64 " created / %" PRIu64 " destroyed, conds %"
+                 PRIu64 " / %" PRIu64, available / M, mappings, direct_free / M,
+                 Atomic::load(&orbis_platform_mutex_inits), Atomic::load(&orbis_platform_mutex_destroys),
+                 Atomic::load(&orbis_platform_cond_inits), Atomic::load(&orbis_platform_cond_destroys));
+  }
+  // Default stack, 2 MiB (what orbis-compat raises Mesa's threads to) and 8 MiB; each result
+  // is logged when it changes.
+  // Prints the sampled mutex-creation callers once, after 32 samples (2048 creations).
+  static void print_mutex_samples() {
+    static bool printed = false;
+    if (printed || Atomic::load(&orbis_mutex_sample_count) < 32) return;
+    printed = true;
+    for (int i = 0; i < 32; i++) {
+      log_info(os)("Orbis mutex creation sample %d: " PTR_FORMAT " " PTR_FORMAT " " PTR_FORMAT " " PTR_FORMAT
+                   " (os::malloc at " PTR_FORMAT ")", i,
+                   p2i(orbis_mutex_samples[i][0]), p2i(orbis_mutex_samples[i][1]),
+                   p2i(orbis_mutex_samples[i][2]), p2i(orbis_mutex_samples[i][3]),
+                   p2i((address)(void* (*)(size_t, MEMFLAGS))&os::malloc));
+    }
+  }
+  // The thread that loaded the JVM is Minecraft's render thread, which creates Mesa's and the
+  // input service's threads; default attributes inherit its scheduling, so log it when it changes.
+  static void report_main_thread() {
+    static int last_prio = -1;
+    static uint64_t last_mask = ~(uint64_t)0;
+    int prio = -1;
+    uint64_t mask = 0;
+    scePthreadGetprio((OrbisPthread)os::Bsd::main_thread(), &prio);
+    scePthreadGetaffinity((OrbisPthread)os::Bsd::main_thread(), &mask);
+    if (prio != last_prio || mask != last_mask) {
+      last_prio = prio;
+      last_mask = mask;
+      log_info(os)("Orbis main thread: priority %d, affinity 0x%" PRIx64, prio, mask);
+    }
+  }
+  static void probe_sce_thread() {
+    static int last = 1;
+    const int result = orbis_probe_sce_thread();
+    if (result != last) {
+      last = result;
+      log_info(os)("Orbis scePthreadCreate probe (2 MiB): 0x%08x (%d JVM threads)", (unsigned)result,
+                   Threads::number_of_threads());
+    }
+  }
+  static void probe_pool() {
+    static int last = -1;
+    const int headroom = orbis_probe_pool_headroom();
+    // Every sample while it is below the cap; at the cap only when it gets there.
+    if (headroom < ORBIS_POOL_PROBE_CAP || last != headroom) {
+      last = headroom;
+      log_info(os)("Orbis pthread pool headroom: %s%d mutexes (%d JVM threads)",
+                   headroom == ORBIS_POOL_PROBE_CAP ? ">=" : "", headroom, Threads::number_of_threads());
+    }
+  }
+  static void probe_thread_headroom() {
+    static int last = -1;
+    int error = 0;
+    const int headroom = orbis_probe_thread_headroom(&error);
+    if (headroom < ORBIS_THREAD_PROBE_CAP || last != headroom) {
+      last = headroom;
+      log_info(os)("Orbis thread headroom: %s%d (stopped by %s; %d JVM threads)",
+                   headroom == ORBIS_THREAD_PROBE_CAP ? ">=" : "", headroom,
+                   error == 0 ? "the cap" : os::errno_name(error), Threads::number_of_threads());
+    }
+  }
+  static void probe_anon() {
+    static size_t last = (size_t)-1;
+    int small_errno = 0;
+    const size_t largest = orbis_largest_anon_kib(&small_errno);
+    const size_t delta = largest > last ? largest - last : last - largest;
+    if (last == (size_t)-1 || delta >= 1024 || (largest < 4096 && largest != last)) {
+      last = largest;
+      log_info(os)("Orbis largest anonymous mapping: " SIZE_FORMAT " KiB (64 KiB: %s)", largest,
+                   small_errno == 0 ? "ok" : os::errno_name(small_errno));
+    }
+    // Once, when large mappings are nearly gone: every mapping, to see what fills the region.
+    static bool listed = false;
+    if (largest < 8 * 1024 && !listed) {
+      listed = true;
+      log_info(os)("Orbis largest anonymous mapping below 8 MiB; listing mappings");
+      orbis_count_mappings(true);
+      orbis_explain_anon_failure();
+    }
+    // Again once it is below 2 MiB, when a thread stack no longer fits.
+    static bool explained_small = false;
+    if (largest < 2 * 1024 && !explained_small) {
+      explained_small = true;
+      orbis_explain_anon_failure();
+    }
+  }
+  static void probe_threads(int* last_results) {
+    static const size_t sizes[3] = {0, 2 * M, 8 * M};
+    for (int i = 0; i < 3; i++) {
+      const int result = orbis_probe_native_thread(sizes[i]);
+      if (result != last_results[i]) {
+        last_results[i] = result;
+        log_info(os)("Orbis native thread probe, stack " SIZE_FORMAT "K: %s (%d JVM threads)", sizes[i] / K,
+                     result == 0 ? "ok" : os::errno_name(result), Threads::number_of_threads());
+      }
+    }
+  }
+  void task() {
+    report(&_last, &_last_mappings);
+    probe_threads(_last_probe);
+    print_mutex_samples();
+    report_main_thread();
+    probe_sce_thread();
+    probe_pool();
+    probe_thread_headroom();
+    probe_anon();
+  }
+};
+
+// PeriodicTask::enroll needs PeriodicTask_lock, which does not exist yet in os::init_2; the
+// first os::create_thread (the VM thread) runs after the VM's mutexes are initialised.
+static void orbis_enroll_flexible_memory_reporter() {
+  static volatile int enrolled = 0;
+  if (!log_is_enabled(Info, os) || Atomic::cmpxchg(&enrolled, 0, 1) != 0) return;
+  (new OrbisFlexibleMemoryReporter())->enroll();
+}
+#endif
+
+// this is called _after_ the global arguments have been parsed
+jint os::init_2(void) {
+#if defined(ORBIS)
+  if (log_is_enabled(Info, os)) {
+    size_t startup = 0;
+    int startup_mappings = 0;
+    OrbisFlexibleMemoryReporter::report(&startup, &startup_mappings);
+  }
+#endif
+#if defined(ORBIS)
+  log_info(os)("Orbis processors: sysconf %ld, affinity mask 0x%" PRIx64 " (%d cores), using %d (active %d)",
+               orbis_sysconf_cpus, orbis_affinity_mask, orbis_affinity_cpus, processor_count(),
+               active_processor_count());
+#endif
+
+  // This could be set after os::Posix::init() but all platforms
+  // have to set it the same so we have to mirror Solaris.
+  DEBUG_ONLY(os::set_mutex_init_done();)
+
+  os::Posix::init_2();
+
+  if (PosixSignals::init() == JNI_ERR) {
+    return JNI_ERR;
+  }
+
+  // Check and sets minimum stack sizes against command line options
+  if (set_minimum_stack_sizes() == JNI_ERR) {
+    return JNI_ERR;
+  }
+
+  // Not supported.
+  FLAG_SET_ERGO(UseNUMA, false);
+  FLAG_SET_ERGO(UseNUMAInterleaving, false);
+
+  if (MaxFDLimit) {
+    // set the number of file descriptors to max. print out error
+    // if getrlimit/setrlimit fails but continue regardless.
+    struct rlimit nbr_files;
+    int status = getrlimit(RLIMIT_NOFILE, &nbr_files);
+    if (status != 0) {
+      log_info(os)("os::init_2 getrlimit failed: %s", os::strerror(errno));
+    } else {
+      rlim_t rlim_original = nbr_files.rlim_cur;
+
+      // On macOS according to setrlimit(2), OPEN_MAX must be used instead
+      // of RLIM_INFINITY, but testing on macOS >= 10.6, reveals that
+      // we can, in fact, use even RLIM_INFINITY.
+      // However, we need to limit the value to 0x100000 (which is the max value
+      // allowed on Linux) so that any existing code that iterates over all allowed
+      // file descriptors, finishes in a reasonable time, without appearing
+      // to hang.
+      nbr_files.rlim_cur = MIN(0x100000, nbr_files.rlim_max);
+
+      status = setrlimit(RLIMIT_NOFILE, &nbr_files);
+      if (status != 0) {
+        // If that fails then try lowering the limit to either OPEN_MAX
+        // (which is safe) or the original limit, whichever was greater.
+        nbr_files.rlim_cur = MAX(OPEN_MAX, rlim_original);
+        status = setrlimit(RLIMIT_NOFILE, &nbr_files);
+      }
+      if (status != 0) {
+        log_info(os)("os::init_2 setrlimit failed: %s", os::strerror(errno));
+      }
+    }
+  }
+
+  // at-exit methods are called in the reverse order of their registration.
+  // atexit functions are called on return from main or as a result of a
+  // call to exit(3C). There can be only 32 of these functions registered
+  // and atexit() does not set errno.
+
+  if (PerfAllowAtExitRegistration) {
+    // only register atexit functions if PerfAllowAtExitRegistration is set.
+    // atexit functions can be delayed until process exit time, which
+    // can be problematic for embedded VM situations. Embedded VMs should
+    // call DestroyJavaVM() to assure that VM resources are released.
+
+    // note: perfMemory_exit_helper atexit function may be removed in
+    // the future if the appropriate cleanup code can be added to the
+    // VM_Exit VMOperation's doit method.
+    if (atexit(perfMemory_exit_helper) != 0) {
+      warning("os::init_2 atexit(perfMemory_exit_helper) failed");
+    }
+  }
+
+  // initialize thread priority policy
+  prio_init();
+
+#ifdef __APPLE__
+  // dynamically link to objective c gc registration
+  void *handleLibObjc = dlopen(OBJC_LIB, RTLD_LAZY);
+  if (handleLibObjc != nullptr) {
+    objc_registerThreadWithCollectorFunction = (objc_registerThreadWithCollector_t) dlsym(handleLibObjc, OBJC_GCREGISTER);
+  }
+#endif
+
+  return JNI_OK;
+}
+
+int os::active_processor_count() {
+  // User has overridden the number of active processors
+  if (ActiveProcessorCount > 0) {
+    log_trace(os)("active_processor_count: "
+                  "active processor count set by user : %d",
+                  ActiveProcessorCount);
+    return ActiveProcessorCount;
+  }
+
+#if defined(__FreeBSD__) && !defined(ORBIS)
+  int online_cpus = 0;
+  cpuset_t mask;
+  if (cpuset_getaffinity(CPU_LEVEL_WHICH, CPU_WHICH_PID, -1, sizeof(mask),
+      &mask) == 0)
+    for (u_int i = 0; i < sizeof(mask) / sizeof(long); i++)
+      online_cpus += __builtin_popcountl(((long *)&mask)[i]);
+  if (online_cpus > 0 && online_cpus <= _processor_count)
+    return online_cpus;
+  online_cpus = sysconf(_SC_NPROCESSORS_ONLN);
+  if (online_cpus >= 1)
+    return online_cpus;
+#endif
+
+  return _processor_count;
+}
+
+uint os::processor_id() {
+#if defined(__APPLE__) && defined(__x86_64__)
+  // Get the initial APIC id and return the associated processor id. The initial APIC
+  // id is limited to 8-bits, which means we can have at most 256 unique APIC ids. If
+  // the system has more processors (or the initial APIC ids are discontiguous) the
+  // APIC id will be truncated and more than one processor will potentially share the
+  // same processor id. This is not optimal, but unlikely to happen in practice. Should
+  // this become a real problem we could switch to using x2APIC ids, which are 32-bit
+  // wide. However, note that x2APIC is Intel-specific, and the wider number space
+  // would require a more complicated mapping approach.
+  uint eax = 0x1;
+  uint ebx;
+  uint ecx = 0;
+  uint edx;
+
+  __asm__ ("cpuid\n\t" : "+a" (eax), "+b" (ebx), "+c" (ecx), "+d" (edx) : );
+
+  uint apic_id = (ebx >> 24) & (processor_id_map_size - 1);
+  int processor_id = Atomic::load(&processor_id_map[apic_id]);
+
+  while (processor_id < 0) {
+    // Assign processor id to APIC id
+    processor_id = Atomic::cmpxchg(&processor_id_map[apic_id], processor_id_unassigned, processor_id_assigning);
+    if (processor_id == processor_id_unassigned) {
+      processor_id = Atomic::fetch_then_add(&processor_id_next, 1) % os::processor_count();
+      Atomic::store(&processor_id_map[apic_id], processor_id);
+    }
+  }
+
+  assert(processor_id >= 0 && processor_id < os::processor_count(), "invalid processor id");
+
+  return (uint)processor_id;
+#else // defined(__APPLE__) && defined(__x86_64__)
+  // Return 0 until we find a good way to get the current processor id on
+  // the platform. Returning 0 is safe, since there is always at least one
+  // processor, but might not be optimal for performance in some cases.
+  return 0;
+#endif
+}
