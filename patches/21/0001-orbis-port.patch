+typedef struct OrbisNativeStat {
+    uint32_t dev;
+    uint32_t ino;
+    uint16_t mode;
+    uint16_t nlink;
+    uint32_t uid;
+    uint32_t gid;
+    uint32_t rdev;
+    struct timespec atim;
+    struct timespec mtim;
+    struct timespec ctim;
+    int64_t size;
+    int64_t blocks;
+    uint32_t blksize;
+    uint32_t flags;
+    uint32_t gen;
+    int32_t lspare;
+    struct timespec birthtim;
