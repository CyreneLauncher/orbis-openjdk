+static inline const char *orbis_resolve_path(JNIEnv *env, const char *path,
+                                             char *resolved,
+                                             size_t capacity) {
+    if (path[0] == '/')
+        return path;
+
+    char cwd_buffer[PATH_MAX + 1];
+    const char *cwd = orbis_working_directory(env, cwd_buffer,
+                                               sizeof(cwd_buffer));
+    size_t cwd_length = strlen(cwd);
+    size_t path_length = strlen(path);
+    size_t separator = cwd_length > 0 && cwd[cwd_length - 1] == '/' ? 0 : 1;
+    if (cwd_length + separator + path_length >= capacity) {
+        errno = ENAMETOOLONG;
+        return NULL;
+    }
+    memcpy(resolved, cwd, cwd_length);
+    if (separator != 0)
+        resolved[cwd_length] = '/';
+    memcpy(resolved + cwd_length + separator, path, path_length + 1);
+    return resolved;
+}
+
+static inline int orbis_stat_path(JNIEnv *env, const char *path,
+                                  OrbisNativeStat *attributes) {
+    char resolved[PATH_MAX + 1];
+    const char *native_path = orbis_resolve_path(env, path, resolved,
+                                                  sizeof(resolved));
+    if (native_path == NULL)
+        return -1;
+    return stat(native_path, (struct stat *)(void *)attributes);
+}
+
+static inline int orbis_fstat_fd(int fd, OrbisNativeStat *attributes) {
+    return fstat(fd, (struct stat *)(void *)attributes);
+}
