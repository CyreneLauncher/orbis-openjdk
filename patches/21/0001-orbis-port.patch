diff --git a/src/hotspot/os/orbis/semaphore_orbis.cpp b/src/hotspot/os/orbis/semaphore_orbis.cpp
new file mode 100644
index 000000000..70bdab8d7
--- /dev/null
+++ b/src/hotspot/os/orbis/semaphore_orbis.cpp
@@ -0,0 +1,79 @@
+/*
+ * Copyright (c) 2026, OpenOrbis contributors.
+ * SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+ */
+
+#include "precompiled.hpp"
+#include "os_posix.hpp"
+#include "semaphore_orbis.hpp"
+#include "runtime/os.hpp"
+
+#include <errno.h>
+
+OrbisSemaphore::OrbisSemaphore(uint value) : _permits(value) {
+  int result = pthread_mutex_init(&_mutex, nullptr);
+  guarantee(result == 0, "pthread_mutex_init failed: %d", result);
+  result = pthread_cond_init(&_condition, nullptr);
+  guarantee(result == 0, "pthread_cond_init failed: %d", result);
+}
+
+OrbisSemaphore::~OrbisSemaphore() {
+  int result = pthread_cond_destroy(&_condition);
+  assert(result == 0, "pthread_cond_destroy failed: %d", result);
+  result = pthread_mutex_destroy(&_mutex);
+  assert(result == 0, "pthread_mutex_destroy failed: %d", result);
+}
+
+void OrbisSemaphore::signal(uint count) {
+  int result = pthread_mutex_lock(&_mutex);
+  assert(result == 0, "pthread_mutex_lock failed: %d", result);
+  _permits += count;
+  result = pthread_cond_broadcast(&_condition);
+  assert(result == 0, "pthread_cond_broadcast failed: %d", result);
+  result = pthread_mutex_unlock(&_mutex);
+  assert(result == 0, "pthread_mutex_unlock failed: %d", result);
+}
+
+void OrbisSemaphore::wait() {
+  int result = pthread_mutex_lock(&_mutex);
+  assert(result == 0, "pthread_mutex_lock failed: %d", result);
+  while (_permits == 0) {
+    result = pthread_cond_wait(&_condition, &_mutex);
+    assert(result == 0, "pthread_cond_wait failed: %d", result);
+  }
+  --_permits;
+  result = pthread_mutex_unlock(&_mutex);
+  assert(result == 0, "pthread_mutex_unlock failed: %d", result);
+}
+
+bool OrbisSemaphore::trywait() {
+  int result = pthread_mutex_lock(&_mutex);
+  assert(result == 0, "pthread_mutex_lock failed: %d", result);
+  bool acquired = _permits != 0;
+  if (acquired) {
+    --_permits;
+  }
+  result = pthread_mutex_unlock(&_mutex);
+  assert(result == 0, "pthread_mutex_unlock failed: %d", result);
+  return acquired;
+}
+
+bool OrbisSemaphore::timedwait(int64_t millis) {
+  struct timespec abstime;
+  os::Posix::to_RTC_abstime(&abstime, millis);
+
+  int result = pthread_mutex_lock(&_mutex);
+  assert(result == 0, "pthread_mutex_lock failed: %d", result);
+  while (_permits == 0) {
+    result = pthread_cond_timedwait(&_condition, &_mutex, &abstime);
+    if (result == ETIMEDOUT) {
+      pthread_mutex_unlock(&_mutex);
+      return false;
+    }
+    assert(result == 0, "pthread_cond_timedwait failed: %d", result);
+  }
+  --_permits;
+  result = pthread_mutex_unlock(&_mutex);
+  assert(result == 0, "pthread_mutex_unlock failed: %d", result);
+  return true;
+}
