+bool os::pd_uncommit_memory(char* addr, size_t size, bool exec) {
+  if (!exec) {
+    void* outer = NULL;
+    size_t direct_size = 0;
+    if (orbis_direct_memory_find_user_ptr(addr, &outer, &direct_size)) {
+      // Direct mappings remain mapped until pd_release_memory() so the
+      // tracked outer allocation can be reclaimed safely.
+      return true;
+    }
+  }
+  bool success = false;
+  int error = 0;
+  if (exec) {
+    if (::madvise(addr, size, MADV_FREE) != 0) {
+      error = errno;
+    } else if (::mprotect(addr, size, PROT_NONE) != 0) {
+      error = errno;
+    } else {
+      success = true;
+    }
+  } else {
+    uintptr_t res = (uintptr_t) ::mmap(addr, size, PROT_NONE,
+        MAP_PRIVATE|MAP_FIXED|MAP_NORESERVE|MAP_ANONYMOUS, -1, 0);
+    success = res != (uintptr_t) MAP_FAILED;
+    if (!success) error = errno;
+  }
+  orbis_vm_map_trace(exec ? "uncommit-madvise-mprotect" : "uncommit-mmap-fixed",
+                     (uintptr_t)addr, success ? (uintptr_t)addr : 0,
+                     size, PROT_NONE,
+                     exec ? MADV_FREE : MAP_PRIVATE|MAP_FIXED|MAP_NORESERVE|MAP_ANONYMOUS,
+                     error, (uintptr_t)__builtin_return_address(0), success);
+  if (!success) errno = error;
+  return success;
+}
