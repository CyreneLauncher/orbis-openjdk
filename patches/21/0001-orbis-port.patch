+
+package sun.awt;
+
+import java.awt.GraphicsEnvironment;
+import java.awt.GraphicsDevice;
+import java.awt.GraphicsConfiguration;
+import java.awt.Graphics2D;
+import java.awt.Toolkit;
+import java.awt.image.BufferedImage;
+import java.awt.AWTError;
+import java.lang.reflect.Constructor;
+
+import sun.java2d.SunGraphicsEnvironment;
+
+/** Platform graphics hooks for the headless Orbis desktop. */
+public final class PlatformGraphicsInfo {
+
+    private PlatformGraphicsInfo() {}
+
+    public static GraphicsEnvironment createGE() {
+        String provider = configuredProvider("orbis.awt.graphicsenv");
+        if (provider != null) {
+            Object value = instantiate(provider, GraphicsEnvironment.class);
+            return (GraphicsEnvironment) value;
+        }
+        return new OrbisGraphicsEnvironment();
+    }
+
+    public static Toolkit createToolkit() {
+        String provider = configuredProvider("orbis.awt.toolkit");
+        if (provider != null) {
+            Object value = instantiate(provider, Toolkit.class);
+            return (Toolkit) value;
+        }
+        return new HeadlessToolkit(null);
+    }
+
+    private static String configuredProvider(String property) {
+        String toolkit = System.getProperty("orbis.awt.toolkit");
+        String graphicsenv = System.getProperty("orbis.awt.graphicsenv");
+        if (toolkit == null && graphicsenv == null) {
+            return null;
+        }
+        if (toolkit == null || toolkit.isBlank() || graphicsenv == null || graphicsenv.isBlank()) {
+            throw new AWTError("orbis.awt.toolkit and orbis.awt.graphicsenv must both be nonblank");
+        }
+        return System.getProperty(property);
+    }
+
+    @SuppressWarnings("removal") // Preserve propagation of legacy ThreadDeath from providers.
+    private static Object instantiate(String className, Class<?> expectedType) {
+        try {
+            ClassLoader system = ClassLoader.getSystemClassLoader();
+            Class<?> type = Class.forName(className, true, system);
+            if (!expectedType.isAssignableFrom(type)) {
+                throw new ClassCastException(className + " is not a " + expectedType.getName());
+            }
+            Constructor<?> constructor = type.getConstructor();
+            return constructor.newInstance();
+        } catch (Throwable failure) {
+            if (failure instanceof ThreadDeath death) throw death;
+            if (failure instanceof VirtualMachineError error) throw error;
+            AWTError error = new AWTError("Unable to initialize Orbis AWT provider " + className);
+            error.initCause(failure);
+            throw error;
+        }
+    }
+
+    public static boolean getDefaultHeadlessProperty() {
+        return true;
+    }
+
+    public static String getDefaultHeadlessMessage() {
+        return "The Orbis target does not provide a desktop display.";
+    }
+
+    private static final class OrbisGraphicsEnvironment extends SunGraphicsEnvironment {
+        @Override
+        protected int getNumScreens() {
+            return 0;
+        }
+
+        @Override
+        protected GraphicsDevice makeScreenDevice(int screen) {
+            throw new InternalError("Orbis has no screen devices");
+        }
+
+        @Override
+        public boolean isDisplayLocal() {
+            return false;
+        }
+    }
+}
