+// DLL functions
+static int local_dladdr(const void* addr, Dl_info* info) {
+#if defined(ORBIS)
+  return 0;
+#else
+#ifdef __APPLE__
+  if (addr == (void*)-1) {
+    // dladdr() in macOS12/Monterey returns success for -1, but that addr
+    // value should not be allowed to work to avoid confusion.
+    return 0;
+  }
+  return dladdr(addr, info);
+#else
+  int ret = dladdr(addr, info);
+  if (ret == 0)
+    return ret;
+  // On BSD dladdr(3) returns the nearest run-time symbol with an
+  // address less than or equal to addr, whereas on linux it only
+  // returns a symbol if the addr >= the symbol address AND <
+  // the symbol address + symbol size. Since the jvm wants more
+  // accurate symbol resolution, only return symbols that are
+  // an exact match so that Decoder::decode can be called as a fallback.
+  if (info->dli_saddr != nullptr && info->dli_sname != nullptr &&
+      addr != info->dli_saddr) {
+    info->dli_saddr = nullptr;
+    info->dli_sname = nullptr;
+  }
+  return ret;
+#endif
+#endif
+}
+
+// Orbis applications are started with /app0 as their native working
+// directory.  That directory is package-backed and is not a suitable place
+// for HotSpot's native temporary files (compiler logs, attach markers, and
+// similar diagnostics).  The launcher supplies ORBIS_JAVA_TMP_DIR from the
+// profile's writable /data directory.  Keep a writable Orbis default for
+// callers that embed the VM without the launcher.
+#ifdef __APPLE__
+// macosx has a secure per-user temporary directory
+char temp_path_storage[PATH_MAX];
+const char* os::get_temp_directory() {
+  static char *temp_path = nullptr;
+  if (temp_path == nullptr) {
+    int pathSize = confstr(_CS_DARWIN_USER_TEMP_DIR, temp_path_storage, PATH_MAX);
+    if (pathSize == 0 || pathSize > PATH_MAX) {
+      strlcpy(temp_path_storage, "/tmp/", sizeof(temp_path_storage));
+    }
+    temp_path = temp_path_storage;
+  }
+  return temp_path;
+}
+#else // __APPLE__
+const char* os::get_temp_directory() {
+  // The JVM PRX can call this before the launcher has established the
+  // profile environment.  Do not permanently cache that early fallback:
+  // otherwise compiler logs remain pointed at /data/orbis-jdk/tmp even
+  // after the runner selects /data/orbis-jdk/runner/tmp.
+  static const char* current_path = "/data/orbis-jdk/tmp";
+  const char* configured = ::getenv("ORBIS_JAVA_TMP_DIR");
+  if (configured == NULL || configured[0] == '\0') {
+    configured = "/data/orbis-jdk/tmp";
+  }
+  size_t length = strlen(configured);
+  if (length >= PATH_MAX) {
+    configured = "/data/orbis-jdk/tmp";
+    length = strlen(configured);
+  }
+
+  const char* observed = __atomic_load_n(&current_path, __ATOMIC_ACQUIRE);
+  if (strcmp(observed, configured) != 0) {
+    char* replacement = static_cast<char*>(::malloc(length + 1));
+    if (replacement != NULL) {
+      memcpy(replacement, configured, length + 1);
+      const char* expected = observed;
+      if (!__atomic_compare_exchange_n(&current_path, &expected, replacement,
+                                       false, __ATOMIC_RELEASE,
+                                       __ATOMIC_ACQUIRE)) {
+        // Paths are intentionally retained for the lifetime of the process;
+        // free only a replacement that lost the publication race.
+        ::free(replacement);
+      }
+    }
+  }
+  return __atomic_load_n(&current_path, __ATOMIC_ACQUIRE);
+}
+#endif // __APPLE__
+
+// check if addr is inside libjvm.so
+#if defined(ORBIS)
+struct OrbisAddressRange {
+  address needle;
+  address base;
+  address top;
+  bool found;
+};
+
+static int orbis_find_address_range(const char* name, address base,
+                                    address top, void* param) {
+  OrbisAddressRange* range = static_cast<OrbisAddressRange*>(param);
+  if (range->needle >= base && range->needle < top) {
+    range->base = base;
+    range->top = top;
+    range->found = true;
+    return 1;
+  }
+  return 0;
+}
+#endif
+
+bool os::address_is_in_vm(address addr) {
+#if defined(ORBIS)
+  if (addr == NULL) {
+    return false;
+  }
+
+  // Orbis has no dladdr().  Locate the module containing a known libjvm
+  // function through the validated kernel module enumeration, then test the
+  // candidate address against that module's actual segment range.
+  OrbisAddressRange range = {
+    CAST_FROM_FN_PTR(address, os::address_is_in_vm), NULL, NULL, false
+  };
+  get_loaded_modules_info(&orbis_find_address_range, &range);
+  return range.found && addr >= range.base && addr < range.top;
+#else
+  static address libjvm_base_addr;
+  Dl_info dlinfo;
+
+  if (libjvm_base_addr == nullptr) {
+    if (dladdr(CAST_FROM_FN_PTR(void *, os::address_is_in_vm), &dlinfo) != 0) {
+      libjvm_base_addr = (address)dlinfo.dli_fbase;
+    }
+    assert(libjvm_base_addr !=nullptr, "Cannot obtain base address for libjvm");
+  }
+
+  if (dladdr((void *)addr, &dlinfo) != 0) {
+    if (libjvm_base_addr == (address)dlinfo.dli_fbase) return true;
+  }
+
+  return false;
+#endif
+}
