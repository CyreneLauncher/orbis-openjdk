+    if (selector == SCE_NET_IF_NAME_LO0) {
+        *flags = IFF_LOOPBACK;
+        if (entry.IPAddress != 0)
+            *flags |= IFF_UP | IFF_RUNNING;
+    } else {
+        struct in_addr active;
+        if (orbis_netctl_info(ORBIS_NET_CTL_INFO_IP_ADDRESS, &info) < 0 ||
+            memchr(info.ip_address, '\0', sizeof(info.ip_address)) == NULL ||
+            sceNetInetPton(AF_INET, info.ip_address, &active) != 1) {
+            errno = EIO;
+            return -1;
+        }
+        if (active.s_addr == (uint32_t)entry.IPAddress && entry.IPAddress != 0) {
+            if (orbis_netctl_info(ORBIS_NET_CTL_INFO_LINK, &info) < 0) {
+                errno = EIO;
+                return -1;
+            }
+            if (info.link != 0)
+                *flags = IFF_UP | IFF_RUNNING | IFF_BROADCAST;
+        } else {
+            // NetCtl describes only the active physical interface; other
+            // interfaces have no verified flags in the published SceNet ABI.
+            errno = ENOTSUP;
+            return -1;
+        }
+    }
+    // No multicast/point-to-point capability bits are exposed by this ABI.
+    return 0;
+}
 #endif /* _ALLBSD_SOURCE */
