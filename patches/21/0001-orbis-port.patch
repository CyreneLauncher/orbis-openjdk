diff --git a/src/hotspot/os/orbis/cxa_guard_orbis.cpp b/src/hotspot/os/orbis/cxa_guard_orbis.cpp
new file mode 100644
index 000000000..8e6fb89a2
--- /dev/null
+++ b/src/hotspot/os/orbis/cxa_guard_orbis.cpp
@@ -0,0 +1,59 @@
+/*
+ * Itanium C++ ABI guards for function-local statics on Orbis.
+ *
+ * The SDK's libc++abi identifies threads with syscall(SYS_gettid), but its syscall() is a stub
+ * that always fails, so every thread gets the same ID (0xffffffff). Two threads reaching the same
+ * uninitialised static at once then look like one thread re-entering its own initialiser, and
+ * libc++abi aborts with "__cxa_guard_acquire detected recursive initialization". Serial GC never
+ * raced there; Parallel GC's workers do (ElapsedCounterSource::seconds).
+ *
+ * Defining the three entry points here keeps the linker from pulling libc++abi's cxa_guard
+ * object. Byte 0 of the guard is the "initialised" flag the compiler checks inline; byte 1 marks
+ * an initialisation in progress. A genuinely recursive initialisation now deadlocks instead of
+ * aborting, which is what the C++ standard leaves undefined anyway.
+ */
+
+#include <pthread.h>
+#include <stdint.h>
+
+namespace {
+pthread_mutex_t guard_lock = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t guard_done = PTHREAD_COND_INITIALIZER;
+
+inline uint8_t* init_byte(uint64_t* guard) { return reinterpret_cast<uint8_t*>(guard); }
+inline uint8_t* pending_byte(uint64_t* guard) { return reinterpret_cast<uint8_t*>(guard) + 1; }
+}
+
+extern "C" int __cxa_guard_acquire(uint64_t* guard) {
+  if (__atomic_load_n(init_byte(guard), __ATOMIC_ACQUIRE) != 0) {
+    return 0;
+  }
+  pthread_mutex_lock(&guard_lock);
+  for (;;) {
+    if (__atomic_load_n(init_byte(guard), __ATOMIC_ACQUIRE) != 0) {
+      pthread_mutex_unlock(&guard_lock);
+      return 0;
+    }
+    if (*pending_byte(guard) == 0) {
+      *pending_byte(guard) = 1;
+      pthread_mutex_unlock(&guard_lock);
+      return 1;
+    }
+    pthread_cond_wait(&guard_done, &guard_lock);
+  }
+}
+
+extern "C" void __cxa_guard_release(uint64_t* guard) {
+  pthread_mutex_lock(&guard_lock);
+  __atomic_store_n(init_byte(guard), 1, __ATOMIC_RELEASE);
+  *pending_byte(guard) = 0;
+  pthread_cond_broadcast(&guard_done);
+  pthread_mutex_unlock(&guard_lock);
+}
+
+extern "C" void __cxa_guard_abort(uint64_t* guard) {
+  pthread_mutex_lock(&guard_lock);
+  *pending_byte(guard) = 0;
+  pthread_cond_broadcast(&guard_done);
+  pthread_mutex_unlock(&guard_lock);
+}
