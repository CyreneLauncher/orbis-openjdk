+// From solaris_i486.s ported to bsd_i486.s
+extern "C" void fixcw();
+
+void os::Bsd::init_thread_fpu_state(void) {
+#ifndef AMD64
+  // Set fpu to 53 bit precision. This happens too early to use a stub.
+  fixcw();
+#endif // !AMD64
+}
