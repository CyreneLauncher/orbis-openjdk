+
+#if defined(ORBIS)
+# include <orbis/libkernel.h>
+# include "orbis_stat.hpp"
+# define CTL_KERN 1
+# define CTL_HW 2
+# define KERN_BOOTTIME 1
+# define KERN_OSTYPE 2
+# define KERN_OSRELEASE 3
+# define KERN_OSVERSION 4
+# define KERN_PROC 5
+# define KERN_PROC_PID 6
+# define KERN_PROC_SHOW_THREADS 7
+# define HW_NCPU 1
+# define HW_MACHINE 2
+# define HW_PHYSMEM 3
+# define HW_MODEL 4
+# define CLK_TCK 100
+# define OPEN_MAX 1024
+
+#define ORBIS_DIRECT_MEMORY_PAGE_SIZE 0x4000u
+#define ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY 1024
+#define ORBIS_DIRECT_MEMORY_ARENA_CAPACITY 32
+#define ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE (4u * 1024u * 1024u)
+#define ORBIS_DIRECT_MEMORY_STATS_INTERVAL 32
+#define ORBIS_DIRECT_MEMORY_CACHED_CHUNK_MAX (16u * 1024u * 1024u)
+#define ORBIS_THREAD_STACK_CAPACITY 256
+
+struct OrbisDirectMemoryAllocation {
+  int state;  // 0 free, 1 reserved, 2 active, 3 releasing
+  int arena_slot;
+  void* outer_ptr;
+  void* user_ptr;
+  size_t requested_size;
+  size_t mapped_size;
+  off_t direct_offset;
+};
+
+struct OrbisDirectMemoryChunk {
+  int state;  // 0 free, 1 reserved, 2 active, 3 releasing
+  OrbisDirectMemoryArena arena;
+  off_t direct_offset;
+};
+
+static OrbisDirectMemoryAllocation
+    orbis_direct_memory_allocations[ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY];
+static OrbisDirectMemoryChunk
+    orbis_direct_memory_chunks[ORBIS_DIRECT_MEMORY_ARENA_CAPACITY];
+static volatile int orbis_direct_memory_lock = 0;
+static volatile uint64_t orbis_direct_memory_attempts = 0;
+static volatile uint64_t orbis_direct_memory_arena_reuses = 0;
+static volatile uint64_t orbis_direct_memory_new_chunks = 0;
+static volatile uint64_t orbis_direct_memory_standalone = 0;
+static volatile uint64_t orbis_direct_memory_kernel_allocates = 0;
+static volatile uint64_t orbis_direct_memory_kernel_maps = 0;
+static volatile uint64_t orbis_direct_memory_kernel_releases = 0;
+static volatile uint64_t orbis_direct_memory_failures = 0;
+static OrbisThreadStackRegistry<ORBIS_THREAD_STACK_CAPACITY>
+    orbis_thread_stack_registry;
+
+static void orbis_direct_memory_lock_registry() {
+  while (__atomic_exchange_n(&orbis_direct_memory_lock, 1, __ATOMIC_ACQUIRE)) {
+    while (__atomic_load_n(&orbis_direct_memory_lock, __ATOMIC_RELAXED)) {
+      // This path is reached only during a libc allocation failure.
+    }
+  }
+}
+
+static void orbis_direct_memory_unlock_registry() {
+  __atomic_store_n(&orbis_direct_memory_lock, 0, __ATOMIC_RELEASE);
+}
+
+static void orbis_direct_memory_log(const char* operation, size_t requested,
+                                    size_t mapped, int result) {
+  char line[224];
+  jio_snprintf(line, sizeof(line),
+               "orbis-jvm: direct memory %s requested=" SIZE_FORMAT
+               " mapped=" SIZE_FORMAT " result=0x%x\n",
+               operation, requested, mapped, (unsigned int)result);
+  sceKernelDebugOutText(0, line);
+}
+
+static void orbis_direct_memory_log_stats(uint64_t attempts) {
+  if (attempts == 0 || attempts % ORBIS_DIRECT_MEMORY_STATS_INTERVAL != 0) {
+    return;
+  }
+  char line[384];
+  jio_snprintf(line, sizeof(line),
+               "orbis-jvm: direct allocator stats attempts=" UINT64_FORMAT
+               " arena_reuse=" UINT64_FORMAT " new_chunks=" UINT64_FORMAT
+               " standalone=" UINT64_FORMAT " dmem_alloc=" UINT64_FORMAT
+               " map=" UINT64_FORMAT " release=" UINT64_FORMAT
+               " failures=" UINT64_FORMAT "\n",
+               __atomic_load_n(&orbis_direct_memory_attempts, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_arena_reuses, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_new_chunks, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_standalone, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_kernel_allocates, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_kernel_maps, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_kernel_releases, __ATOMIC_RELAXED),
+               __atomic_load_n(&orbis_direct_memory_failures, __ATOMIC_RELAXED));
+  sceKernelDebugOutText(0, line);
+}
+
+static void orbis_enroll_flexible_memory_reporter();
+
+static bool orbis_allocate_thread_stack(size_t stack_size, void** mapping_out,
+                                        size_t* mapping_size_out,
+                                        off_t* direct_offset_out,
+                                        void** stack_out) {
+  const size_t guard_size = os::vm_page_size();
+  if (stack_size > SIZE_MAX - guard_size) return false;
+  const size_t mapping_size = align_up(stack_size + guard_size,
+                                       (size_t)ORBIS_DIRECT_MEMORY_PAGE_SIZE);
+  off_t direct_offset = 0;
+  int result = sceKernelAllocateDirectMemory(
+      0, ORBIS_KERNEL_MAIN_DMEM_SIZE, mapping_size,
+      ORBIS_DIRECT_MEMORY_PAGE_SIZE, ORBIS_KERNEL_WB_ONION, &direct_offset);
+  if (result != 0) {
+    orbis_direct_memory_log("thread stack allocate failed", stack_size,
+                            mapping_size, result);
+    return false;
+  }
+
+  void* mapping = NULL;
+  result = sceKernelMapDirectMemory(&mapping, mapping_size,
+                                    PROT_READ | PROT_WRITE, 0, direct_offset,
+                                    ORBIS_DIRECT_MEMORY_PAGE_SIZE);
+  if (result != 0 || mapping == NULL) {
+    sceKernelReleaseDirectMemory(direct_offset, mapping_size);
+    orbis_direct_memory_log("thread stack map failed", stack_size,
+                            mapping_size, result);
+    return false;
+  }
+  if (::mprotect(mapping, guard_size, PROT_NONE) != 0) {
+    const int error = errno;
+    ::munmap(mapping, mapping_size);
+    sceKernelReleaseDirectMemory(direct_offset, mapping_size);
+    orbis_direct_memory_log("thread stack guard failed", stack_size,
+                            mapping_size, error);
+    return false;
+  }
+
+  *mapping_out = mapping;
+  *mapping_size_out = mapping_size;
+  *direct_offset_out = direct_offset;
+  *stack_out = reinterpret_cast<char*>(mapping) + guard_size;
+  return true;
+}
+
+static void orbis_release_thread_stack(void* mapping, size_t mapping_size,
+                                       off_t direct_offset) {
+  if (::munmap(mapping, mapping_size) != 0) {
+    orbis_direct_memory_log("thread stack unmap failed", mapping_size,
+                            mapping_size, errno);
+    return;
+  }
+  const int result = sceKernelReleaseDirectMemory(direct_offset, mapping_size);
+  if (result != 0) {
+    orbis_direct_memory_log("thread stack release failed", mapping_size,
+                            mapping_size, result);
+  }
+}
+
+static void orbis_reap_thread_stacks() {
+  OrbisRetiredThreadStack retired;
+  while (orbis_thread_stack_registry.take_completed(&retired)) {
+    const int result = pthread_join((pthread_t)retired.thread_id, NULL);
+    if (result != 0) {
+      orbis_direct_memory_log("thread join failed", retired.mapping_size,
+                              retired.mapping_size, result);
+      // Keep the mapping alive if pthread cannot confirm termination.
+      continue;
+    }
+    orbis_release_thread_stack(retired.mapping, retired.mapping_size,
+                               (off_t)retired.direct_offset);
+    orbis_thread_stack_registry.finish_reap(retired.slot);
+  }
+}
+
+static void orbis_direct_memory_clear_allocation_locked(int slot) {
+  OrbisDirectMemoryAllocation* allocation =
+      &orbis_direct_memory_allocations[slot];
+  allocation->state = 0;
+  allocation->arena_slot = -1;
+  allocation->outer_ptr = NULL;
+  allocation->user_ptr = NULL;
+  allocation->requested_size = 0;
+  allocation->mapped_size = 0;
+  allocation->direct_offset = 0;
+}
+
+static int orbis_direct_memory_reserve_allocation_locked() {
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY; ++i) {
+    if (orbis_direct_memory_allocations[i].state == 0) {
+      orbis_direct_memory_allocations[i].state = 1;
+      orbis_direct_memory_allocations[i].arena_slot = -1;
+      return i;
+    }
+  }
+  return -1;
+}
+
+static bool orbis_direct_memory_map_chunk(size_t mapped_size,
+                                          OrbisDirectMemoryArena* arena,
+                                          off_t* direct_offset_out,
+                                          int* failed_result_out) {
+  off_t direct_offset = 0;
+  __atomic_add_fetch(&orbis_direct_memory_kernel_allocates, 1, __ATOMIC_RELAXED);
+  int result = sceKernelAllocateDirectMemory(
+      0, ORBIS_KERNEL_MAIN_DMEM_SIZE, mapped_size,
+      ORBIS_DIRECT_MEMORY_PAGE_SIZE, ORBIS_KERNEL_WB_ONION, &direct_offset);
+  if (result != 0) {
+    *failed_result_out = result;
+    return false;
+  }
+
+  void* mapping = NULL;
+  __atomic_add_fetch(&orbis_direct_memory_kernel_maps, 1, __ATOMIC_RELAXED);
+  result = sceKernelMapDirectMemory(
+      &mapping, mapped_size, PROT_READ | PROT_WRITE, 0, direct_offset,
+      ORBIS_DIRECT_MEMORY_PAGE_SIZE);
+  if (result != 0 || mapping == NULL) {
+    __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1, __ATOMIC_RELAXED);
+    const int release_result =
+        sceKernelReleaseDirectMemory(direct_offset, mapped_size);
+    *failed_result_out = result != 0 ? result : release_result;
+    return false;
+  }
+
+  if (!orbis_direct_memory_arena_init(arena, mapping, mapped_size)) {
+    const int unmap_result = ::munmap(mapping, mapped_size);
+    __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1, __ATOMIC_RELAXED);
+    const int release_result =
+        sceKernelReleaseDirectMemory(direct_offset, mapped_size);
+    *failed_result_out = unmap_result != 0 ? errno :
+        (release_result != 0 ? release_result : EINVAL);
+    return false;
+  }
+  *direct_offset_out = direct_offset;
+  return true;
+}
+
+static bool orbis_direct_memory_allocate_standalone(size_t size,
+                                                     size_t mapped_size,
+                                                     int slot) {
+  off_t direct_offset = 0;
+  __atomic_add_fetch(&orbis_direct_memory_kernel_allocates, 1, __ATOMIC_RELAXED);
+  int result = sceKernelAllocateDirectMemory(
+      0, ORBIS_KERNEL_MAIN_DMEM_SIZE, mapped_size,
+      ORBIS_DIRECT_MEMORY_PAGE_SIZE, ORBIS_KERNEL_WB_ONION, &direct_offset);
+  if (result != 0) {
+    __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+    orbis_direct_memory_lock_registry();
+    orbis_direct_memory_clear_allocation_locked(slot);
+    orbis_direct_memory_unlock_registry();
+    errno = ENOMEM;
+    orbis_direct_memory_log("allocate failed", size, mapped_size, result);
+    return false;
+  }
+
+  void* mapping = NULL;
+  __atomic_add_fetch(&orbis_direct_memory_kernel_maps, 1, __ATOMIC_RELAXED);
+  result = sceKernelMapDirectMemory(
+      &mapping, mapped_size, PROT_READ | PROT_WRITE, 0, direct_offset,
+      ORBIS_DIRECT_MEMORY_PAGE_SIZE);
+  if (result != 0 || mapping == NULL) {
+    __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1, __ATOMIC_RELAXED);
+    const int release_result =
+        sceKernelReleaseDirectMemory(direct_offset, mapped_size);
+    __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+    orbis_direct_memory_lock_registry();
+    orbis_direct_memory_clear_allocation_locked(slot);
+    orbis_direct_memory_unlock_registry();
+    errno = ENOMEM;
+    orbis_direct_memory_log("map failed", size, mapped_size,
+                            result != 0 ? result : release_result);
+    return false;
+  }
+
+  orbis_direct_memory_lock_registry();
+  OrbisDirectMemoryAllocation* allocation =
+      &orbis_direct_memory_allocations[slot];
+  allocation->outer_ptr = mapping;
+  allocation->user_ptr = NULL;
+  allocation->requested_size = size;
+  allocation->mapped_size = mapped_size;
+  allocation->direct_offset = direct_offset;
+  allocation->arena_slot = -1;
+  allocation->state = 2;
+  orbis_direct_memory_unlock_registry();
+  __atomic_add_fetch(&orbis_direct_memory_standalone, 1, __ATOMIC_RELAXED);
+  return true;
+}
+
+void* orbis_direct_memory_allocate(size_t size) {
+  if (size == 0 || size > SIZE_MAX - (ORBIS_DIRECT_MEMORY_PAGE_SIZE - 1)) {
+    errno = ENOMEM;
+    return NULL;
+  }
+  if (size >= 64 * M) {
+    // Direct memory is physically backed in full, so every large request is worth naming.
+    char line[160];
+    jio_snprintf(line, sizeof(line),
+                 "orbis-jvm: direct allocation " SIZE_FORMAT " MiB from " PTR_FORMAT " <- " PTR_FORMAT "\n",
+                 size / M, p2i(__builtin_return_address(0)), p2i(__builtin_return_address(1)));
+    sceKernelDebugOutText(0, line);
+    // dll_address_to_library_name does not resolve on Orbis; the reference address lets the
+    // callers be turned into libjvm offsets offline.
+    log_info(os)("Orbis direct allocation " SIZE_FORMAT " MiB from " PTR_FORMAT " <- " PTR_FORMAT
+                 " <- " PTR_FORMAT " (os::malloc at " PTR_FORMAT ")", size / M,
+                 p2i(__builtin_return_address(0)), p2i(__builtin_return_address(1)),
+                 p2i(__builtin_return_address(2)), p2i((address)(void* (*)(size_t, MEMFLAGS))&os::malloc));
+  }
+  const size_t mapped_size =
+      (size + ORBIS_DIRECT_MEMORY_PAGE_SIZE - 1) &
+      ~(size_t)(ORBIS_DIRECT_MEMORY_PAGE_SIZE - 1);
+
+  const uint64_t attempts =
+      __atomic_add_fetch(&orbis_direct_memory_attempts, 1, __ATOMIC_RELAXED);
+  int allocation_slot = -1;
+  int chunk_slot = -1;
+  orbis_direct_memory_lock_registry();
+  allocation_slot = orbis_direct_memory_reserve_allocation_locked();
+  if (allocation_slot < 0) {
+    orbis_direct_memory_unlock_registry();
+    __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+    errno = ENOMEM;
+    orbis_direct_memory_log("registry full", size, mapped_size, ENOMEM);
+    orbis_direct_memory_log_stats(attempts);
+    return NULL;
+  }
+
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ARENA_CAPACITY; ++i) {
+    OrbisDirectMemoryChunk* chunk = &orbis_direct_memory_chunks[i];
+    if (chunk->state != 2) continue;
+    size_t allocated_size = 0;
+    void* allocation = orbis_direct_memory_arena_allocate(
+        &chunk->arena, size, &allocated_size);
+    if (allocation != NULL) {
+      OrbisDirectMemoryAllocation* record =
+          &orbis_direct_memory_allocations[allocation_slot];
+      record->arena_slot = i;
+      record->outer_ptr = allocation;
+      record->user_ptr = NULL;
+      record->requested_size = size;
+      record->mapped_size = allocated_size;
+      record->state = 2;
+      orbis_direct_memory_unlock_registry();
+      __atomic_add_fetch(&orbis_direct_memory_arena_reuses, 1, __ATOMIC_RELAXED);
+      orbis_direct_memory_log_stats(attempts);
+      return allocation;
+    }
+  }
+
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ARENA_CAPACITY; ++i) {
+    if (orbis_direct_memory_chunks[i].state == 0) {
+      orbis_direct_memory_chunks[i].state = 1;
+      chunk_slot = i;
+      break;
+    }
+  }
+  orbis_direct_memory_unlock_registry();
+
+  if (chunk_slot >= 0 && mapped_size <= SIZE_MAX - (ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE - 1)) {
+    size_t chunk_size = mapped_size;
+    if (chunk_size < ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE) {
+      chunk_size = ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE;
+    } else {
+      chunk_size = (chunk_size + ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE - 1) &
+          ~(size_t)(ORBIS_DIRECT_MEMORY_ARENA_MIN_SIZE - 1);
+    }
+    OrbisDirectMemoryArena arena;
+    off_t direct_offset = 0;
+    int failure_result = ENOMEM;
+    if (orbis_direct_memory_map_chunk(chunk_size, &arena, &direct_offset,
+                                     &failure_result)) {
+      orbis_direct_memory_lock_registry();
+      OrbisDirectMemoryChunk* chunk = &orbis_direct_memory_chunks[chunk_slot];
+      chunk->arena = arena;
+      chunk->direct_offset = direct_offset;
+      chunk->state = 2;
+      size_t allocated_size = 0;
+      void* allocation = orbis_direct_memory_arena_allocate(
+          &chunk->arena, size, &allocated_size);
+      if (allocation != NULL) {
+        OrbisDirectMemoryAllocation* record =
+            &orbis_direct_memory_allocations[allocation_slot];
+        record->arena_slot = chunk_slot;
+        record->outer_ptr = allocation;
+        record->user_ptr = NULL;
+        record->requested_size = size;
+        record->mapped_size = allocated_size;
+        record->direct_offset = 0;
+        record->state = 2;
+        orbis_direct_memory_unlock_registry();
+        __atomic_add_fetch(&orbis_direct_memory_new_chunks, 1, __ATOMIC_RELAXED);
+        orbis_direct_memory_log_stats(attempts);
+        return allocation;
+      }
+      chunk->state = 3;
+      OrbisDirectMemoryChunk chunk_to_discard = *chunk;
+      orbis_direct_memory_unlock_registry();
+      const int unmap_result = ::munmap(
+          reinterpret_cast<void*>(chunk_to_discard.arena.base),
+          chunk_to_discard.arena.size);
+      if (unmap_result == 0) {
+        __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1,
+                           __ATOMIC_RELAXED);
+        const int release_result = sceKernelReleaseDirectMemory(
+            chunk_to_discard.direct_offset, chunk_to_discard.arena.size);
+        if (release_result != 0) {
+          __atomic_add_fetch(&orbis_direct_memory_failures, 1,
+                             __ATOMIC_RELAXED);
+          orbis_direct_memory_log("arena cleanup release failed",
+                                  chunk_to_discard.arena.size,
+                                  chunk_to_discard.arena.size, release_result);
+        }
+        orbis_direct_memory_lock_registry();
+        orbis_direct_memory_chunks[chunk_slot].state = 0;
+        orbis_direct_memory_unlock_registry();
+      } else {
+        __atomic_add_fetch(&orbis_direct_memory_failures, 1,
+                           __ATOMIC_RELAXED);
+        orbis_direct_memory_lock_registry();
+        orbis_direct_memory_chunks[chunk_slot].state = 2;
+        orbis_direct_memory_unlock_registry();
+        orbis_direct_memory_log("arena cleanup unmap failed",
+                                chunk_to_discard.arena.size,
+                                chunk_to_discard.arena.size, errno);
+      }
+      failure_result = ENOMEM;
+    }
+    __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+    orbis_direct_memory_log("arena unavailable", size, chunk_size,
+                            failure_result);
+    orbis_direct_memory_lock_registry();
+    if (orbis_direct_memory_chunks[chunk_slot].state == 1 ||
+        orbis_direct_memory_chunks[chunk_slot].state == 3) {
+      orbis_direct_memory_chunks[chunk_slot].state = 0;
+    }
+    orbis_direct_memory_unlock_registry();
+  } else if (chunk_slot >= 0) {
+    orbis_direct_memory_lock_registry();
+    orbis_direct_memory_chunks[chunk_slot].state = 0;
+    orbis_direct_memory_unlock_registry();
+  }
+
+  if (!orbis_direct_memory_allocate_standalone(size, mapped_size,
+                                                allocation_slot)) {
+    orbis_direct_memory_log_stats(attempts);
+    return NULL;
+  }
+  orbis_direct_memory_log_stats(attempts);
+  orbis_direct_memory_lock_registry();
+  void* result = orbis_direct_memory_allocations[allocation_slot].outer_ptr;
+  orbis_direct_memory_unlock_registry();
+  return result;
+}
+
+void orbis_direct_memory_set_user_ptr(void* outer_ptr, void* user_ptr) {
+  orbis_direct_memory_lock_registry();
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY; ++i) {
+    OrbisDirectMemoryAllocation* allocation =
+        &orbis_direct_memory_allocations[i];
+    if (allocation->state == 2 && allocation->outer_ptr == outer_ptr) {
+      allocation->user_ptr = user_ptr;
+      break;
+    }
+  }
+  orbis_direct_memory_unlock_registry();
+}
+
+bool orbis_direct_memory_find_user_ptr(void* user_ptr, void** outer_ptr,
+                                       size_t* requested_size) {
+  bool found = false;
+  orbis_direct_memory_lock_registry();
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY; ++i) {
+    OrbisDirectMemoryAllocation* allocation =
+        &orbis_direct_memory_allocations[i];
+    const uintptr_t address = reinterpret_cast<uintptr_t>(user_ptr);
+    const uintptr_t base = reinterpret_cast<uintptr_t>(allocation->outer_ptr);
+    if (allocation->state == 2 &&
+        ((allocation->user_ptr == user_ptr) ||
+         (address >= base && address < base + allocation->mapped_size))) {
+      *outer_ptr = allocation->outer_ptr;
+      *requested_size = allocation->requested_size;
+      found = true;
+      break;
+    }
+  }
+  orbis_direct_memory_unlock_registry();
+  return found;
+}
+
+bool orbis_direct_memory_release(void* outer_ptr) {
+  OrbisDirectMemoryAllocation saved;
+  int slot = -1;
+  orbis_direct_memory_lock_registry();
+  for (int i = 0; i < ORBIS_DIRECT_MEMORY_ALLOCATION_CAPACITY; ++i) {
+    OrbisDirectMemoryAllocation* allocation =
+        &orbis_direct_memory_allocations[i];
+    if (allocation->state == 2 && allocation->outer_ptr == outer_ptr) {
+      slot = i;
+      allocation->state = 3;
+      saved = *allocation;
+      break;
+    }
+  }
+  orbis_direct_memory_unlock_registry();
+  if (slot < 0) return false;
+  if (saved.mapped_size >= 64 * M) {
+    log_info(os)("Orbis direct release " SIZE_FORMAT " MiB at " PTR_FORMAT " (%s)", saved.mapped_size / M,
+                 p2i(outer_ptr), saved.arena_slot >= 0 ? "arena chunk" : "standalone");
+  }
+
+  if (saved.arena_slot >= 0) {
+    int chunk_to_release = -1;
+    OrbisDirectMemoryChunk chunk_saved;
+    orbis_direct_memory_lock_registry();
+    OrbisDirectMemoryChunk* chunk =
+        &orbis_direct_memory_chunks[saved.arena_slot];
+    if (chunk->state != 2 ||
+        !orbis_direct_memory_arena_release(&chunk->arena, saved.outer_ptr,
+                                           saved.mapped_size)) {
+      orbis_direct_memory_allocations[slot].state = 2;
+      orbis_direct_memory_unlock_registry();
+      orbis_direct_memory_log("arena free rejected", saved.requested_size,
+                              saved.mapped_size, EINVAL);
+      return true;
+    }
+    orbis_direct_memory_clear_allocation_locked(slot);
+
+    if (orbis_direct_memory_arena_is_empty(&chunk->arena)) {
+      // One empty chunk stays cached for reuse - but only a small one. Caching a large chunk
+      // strands it: the Parallel GC heap reservation released a 1032 MiB first attempt, kept
+      // as the cached chunk, then mapped 1040 MiB anew, leaving a gigabyte of physical direct
+      // memory unusable and too little for native thread stacks.
+      bool another_empty_chunk =
+          chunk->arena.size > ORBIS_DIRECT_MEMORY_CACHED_CHUNK_MAX;
+      for (int i = 0; i < ORBIS_DIRECT_MEMORY_ARENA_CAPACITY; ++i) {
+        if (i != saved.arena_slot &&
+            orbis_direct_memory_chunks[i].state == 2 &&
+            orbis_direct_memory_arena_is_empty(
+                &orbis_direct_memory_chunks[i].arena)) {
+          another_empty_chunk = true;
+          break;
+        }
+      }
+      if (another_empty_chunk) {
+        chunk_to_release = saved.arena_slot;
+        chunk->state = 3;
+        chunk_saved = *chunk;
+      }
+    }
+    orbis_direct_memory_unlock_registry();
+    if (chunk_to_release < 0) return true;
+
+    if (::munmap(reinterpret_cast<void*>(chunk_saved.arena.base),
+                 chunk_saved.arena.size) != 0) {
+      const int error = errno;
+      orbis_direct_memory_lock_registry();
+      orbis_direct_memory_chunks[chunk_to_release].state = 2;
+      orbis_direct_memory_unlock_registry();
+      orbis_direct_memory_log("arena unmap failed", chunk_saved.arena.size,
+                              chunk_saved.arena.size, error);
+      return true;
+    }
+    __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1, __ATOMIC_RELAXED);
+    const int release_result = sceKernelReleaseDirectMemory(
+        chunk_saved.direct_offset, chunk_saved.arena.size);
+    orbis_direct_memory_lock_registry();
+    orbis_direct_memory_chunks[chunk_to_release].state = 0;
+    orbis_direct_memory_unlock_registry();
+    if (release_result != 0) {
+      __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+      orbis_direct_memory_log("arena release failed", chunk_saved.arena.size,
+                              chunk_saved.arena.size, release_result);
+    }
+    return true;
+  }
+
+  if (::munmap(saved.outer_ptr, saved.mapped_size) != 0) {
+    const int error = errno;
+    orbis_direct_memory_lock_registry();
+    orbis_direct_memory_allocations[slot].state = 2;
+    orbis_direct_memory_unlock_registry();
+    orbis_direct_memory_log("unmap failed", saved.requested_size,
+                            saved.mapped_size, error);
+    return true;  // It is still a tracked mapping; never send it to libc free.
+  }
+
+  __atomic_add_fetch(&orbis_direct_memory_kernel_releases, 1, __ATOMIC_RELAXED);
+  const int release_result =
+      sceKernelReleaseDirectMemory(saved.direct_offset, saved.mapped_size);
+  orbis_direct_memory_lock_registry();
+  orbis_direct_memory_clear_allocation_locked(slot);
+  orbis_direct_memory_unlock_registry();
+  if (release_result != 0) {
+    __atomic_add_fetch(&orbis_direct_memory_failures, 1, __ATOMIC_RELAXED);
+    orbis_direct_memory_log("release failed", saved.requested_size,
+                            saved.mapped_size, release_result);
+  }
+  return true;
+}
