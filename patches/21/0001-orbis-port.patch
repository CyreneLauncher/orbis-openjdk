+
+#ifndef OS_ORBIS_ORBIS_DIRECT_MEMORY_ARENA_HPP
+#define OS_ORBIS_ORBIS_DIRECT_MEMORY_ARENA_HPP
+
+#include <stddef.h>
+#include <stdint.h>
+
+static const size_t ORBIS_ARENA_PAGE_SIZE = 0x4000;
+
+struct OrbisDirectMemoryFreeSpan {
+  size_t size;
+  OrbisDirectMemoryFreeSpan* next;
+};
+
+struct OrbisDirectMemoryArena {
+  uintptr_t base;
+  size_t size;
+  OrbisDirectMemoryFreeSpan* free_spans;
+};
+
+static inline bool orbis_direct_memory_arena_init(
+    OrbisDirectMemoryArena* arena, void* memory, size_t size) {
+  if (arena == NULL || memory == NULL || size < sizeof(OrbisDirectMemoryFreeSpan) ||
+      size % ORBIS_ARENA_PAGE_SIZE != 0 ||
+      reinterpret_cast<uintptr_t>(memory) % ORBIS_ARENA_PAGE_SIZE != 0 ||
+      reinterpret_cast<uintptr_t>(memory) > UINTPTR_MAX - size) {
+    return false;
+  }
+  arena->base = reinterpret_cast<uintptr_t>(memory);
+  arena->size = size;
+  arena->free_spans = reinterpret_cast<OrbisDirectMemoryFreeSpan*>(memory);
+  arena->free_spans->size = size;
+  arena->free_spans->next = NULL;
+  return true;
+}
+
+static inline void* orbis_direct_memory_arena_allocate(
+    OrbisDirectMemoryArena* arena, size_t size, size_t* allocated_size) {
+  if (arena == NULL || size == 0 ||
+      size > SIZE_MAX - (ORBIS_ARENA_PAGE_SIZE - 1)) {
+    return NULL;
+  }
+  const size_t span_size = (size + ORBIS_ARENA_PAGE_SIZE - 1) &
+      ~(size_t)(ORBIS_ARENA_PAGE_SIZE - 1);
+  if (span_size < sizeof(OrbisDirectMemoryFreeSpan)) {
+    return NULL;
+  }
+
+  OrbisDirectMemoryFreeSpan* previous = NULL;
+  OrbisDirectMemoryFreeSpan* span = arena->free_spans;
+  while (span != NULL && span->size < span_size) {
+    previous = span;
+    span = span->next;
+  }
+  if (span == NULL) {
+    return NULL;
+  }
+
+  const uintptr_t address = reinterpret_cast<uintptr_t>(span);
+  const size_t remainder_size = span->size - span_size;
+  if (remainder_size == 0) {
+    if (previous == NULL) {
+      arena->free_spans = span->next;
+    } else {
+      previous->next = span->next;
+    }
+  } else {
+    OrbisDirectMemoryFreeSpan* remainder =
+        reinterpret_cast<OrbisDirectMemoryFreeSpan*>(address + span_size);
+    remainder->size = remainder_size;
+    remainder->next = span->next;
+    if (previous == NULL) {
+      arena->free_spans = remainder;
+    } else {
+      previous->next = remainder;
+    }
+  }
+  if (allocated_size != NULL) {
+    *allocated_size = span_size;
+  }
+  return reinterpret_cast<void*>(address);
+}
+
+static inline bool orbis_direct_memory_arena_release(
+    OrbisDirectMemoryArena* arena, void* memory, size_t size) {
+  if (arena == NULL || memory == NULL || size == 0 ||
+      size % ORBIS_ARENA_PAGE_SIZE != 0) {
+    return false;
+  }
+  const uintptr_t address = reinterpret_cast<uintptr_t>(memory);
+  if (address < arena->base || address > UINTPTR_MAX - size ||
+      address + size > arena->base + arena->size ||
+      address % ORBIS_ARENA_PAGE_SIZE != 0) {
+    return false;
+  }
+
+  OrbisDirectMemoryFreeSpan* previous = NULL;
+  OrbisDirectMemoryFreeSpan* next = arena->free_spans;
+  while (next != NULL && reinterpret_cast<uintptr_t>(next) < address) {
+    previous = next;
+    next = next->next;
+  }
+  if ((previous != NULL &&
+       reinterpret_cast<uintptr_t>(previous) + previous->size > address) ||
+      (next != NULL && address + size > reinterpret_cast<uintptr_t>(next))) {
+    return false;
+  }
+
+  OrbisDirectMemoryFreeSpan* released =
+      reinterpret_cast<OrbisDirectMemoryFreeSpan*>(address);
+  released->size = size;
+  released->next = next;
+  if (previous == NULL) {
+    arena->free_spans = released;
+  } else {
+    previous->next = released;
+  }
+
+  if (next != NULL && address + released->size == reinterpret_cast<uintptr_t>(next)) {
+    released->size += next->size;
+    released->next = next->next;
+  }
+  if (previous != NULL &&
+      reinterpret_cast<uintptr_t>(previous) + previous->size == address) {
+    previous->size += released->size;
+    previous->next = released->next;
+  }
+  return true;
+}
+
+static inline bool orbis_direct_memory_arena_is_empty(
+    const OrbisDirectMemoryArena* arena) {
+  return arena != NULL && arena->free_spans != NULL &&
+      reinterpret_cast<uintptr_t>(arena->free_spans) == arena->base &&
+      arena->free_spans->size == arena->size && arena->free_spans->next == NULL;
+}
+
+#endif  // OS_ORBIS_ORBIS_DIRECT_MEMORY_ARENA_HPP
