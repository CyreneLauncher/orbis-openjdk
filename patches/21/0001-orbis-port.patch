+#define SIGXFSZ 25
+#undef SIGVTALRM
+#define SIGVTALRM 26
+#undef SIGPROF
+#define SIGPROF 27
+#undef SIGWINCH
+#define SIGWINCH 28
+#undef SIGINFO
+#define SIGINFO 29
+#undef SIGUSR1
+#define SIGUSR1 30
+#undef SIGUSR2
+#define SIGUSR2 31
+#undef SIGUNUSED
+#define SIGUNUSED SIGSYS
+
+// Values consumed by the Orbis signal ABI, rather than the legacy Linux
+// values published by the compatibility header.
+#undef SA_ONSTACK
