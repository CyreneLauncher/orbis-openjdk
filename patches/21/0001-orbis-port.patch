+        fprintf(stderr, "orbis-net: DNS initialization failed for %s: 0x%08x\n",
+                hostname, (unsigned int)status);
+        return status;
+    }
+
+    resolver = sceNetResolverCreate("openjdk", orbis_net_pool_id, 0);
+    if (resolver < 0) {
+        snprintf(error_detail, error_detail_size,
