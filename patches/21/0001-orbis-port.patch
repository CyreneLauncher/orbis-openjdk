+++ b/test/orbis/verify-configuration.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Check host/target separation in a generated Orbis build specification."""
+import re
+import sys
+from pathlib import Path
+
+spec = Path(sys.argv[1]).read_text()
+values = dict(re.findall(r'^([A-Z][A-Za-z0-9_]*)[ \t]*:?=[ \t]*(.*)$', spec, re.M))
+assert values['OPENJDK_TARGET_OS'] == 'orbis', values.get('OPENJDK_TARGET_OS')
+assert values['OPENJDK_BUILD_OS'] == 'linux', values.get('OPENJDK_BUILD_OS')
+assert values['OPENJDK_TARGET_CPU'] == 'x86_64', values.get('OPENJDK_TARGET_CPU')
+assert '-DORBIS' in values['JVM_CFLAGS'], 'Orbis VM definitions missing'
+build_spec = Path(sys.argv[2]).read_text()
+build_values = dict(re.findall(r'^([A-Z][A-Za-z0-9_]*)[ \t]*:?=[ \t]*(.*)$', build_spec, re.M))
+for key in ('JVM_CFLAGS', 'CFLAGS_JDKLIB', 'JVM_LIBS'):
+    value = build_values[key]
+    assert '-DORBIS' not in value and '-D__ORBIS__' not in value, (key, value)
+    assert '-lkernel' not in value and 'PS4Toolchain' not in value, (key, value)
+features = values['JVM_FEATURES_server'].split()
+assert 'serialgc' in features, features
+# As the JDK 17 release port: Serial and Parallel (the runner's -XX:+UseParallelGC) and Epsilon;
+# G1 cannot create its VM on Orbis, and the concurrent collectors are not ported.
+assert {'serialgc', 'parallelgc'} <= set(features), features
+assert not {'g1gc', 'shenandoahgc', 'zgc'} & set(features), features
+print('PASS: Orbis target, Linux host tools and Serial/Parallel GC configuration')
