+#ifdef ORBIS
+// libkernel backs every pthread mutex and condition variable with a small fixed internal pool
+// (technote 235). A metaspace lock per hidden-class CLD - one per lambda - created ~250 pthread
+// objects a second while Minecraft and Fabric loaded, never freed, until the pool was empty and
+// no thread anywhere in the process could start (Mesa's queues, the input service). Hidden-class
+// CLDs share one lock instead; it is held only briefly around a metaspace allocation.
+static Mutex* orbis_shared_metaspace_lock() {
+  static Mutex* volatile shared = NULL;
+  Mutex* lock = Atomic::load_acquire(&shared);
+  if (lock == NULL) {
+    Mutex* created = new Mutex(Mutex::nosafepoint-2, "Shared metaspace allocation lock");
+    lock = Atomic::cmpxchg(&shared, (Mutex*)NULL, created);
+    if (lock == NULL) {
+      lock = created;
+    } else {
+      delete created;
+    }
+  }
+  return lock;
+}
