--- /dev/null
+++ b/src/java.base/unix/native/libnio/ch/orbis_nonblocking.h
@@ -0,0 +1,79 @@
+#ifndef ORBIS_NONBLOCKING_H
+#define ORBIS_NONBLOCKING_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+
+/*
+ * libkernel speaks the FreeBSD ABI, but the SDK's sys/socket.h carries the
+ * Linux MSG_* values (its MSG_DONTWAIT, 0x40, is FreeBSD's MSG_WAITALL) and
+ * defines no FreeBSD FIONBIO.  These are FreeBSD's.
+ */
+#define ORBIS_MSG_DONTWAIT 0x80
+#define ORBIS_FIONBIO 0x8004667eUL /* _IOW('f', 126, int) */
+/* Sony's own switch (SCE_NET_SOL_SOCKET, SCE_NET_SO_NBIO); sceNetSetsockopt is this syscall. */
+#define ORBIS_SOL_SOCKET 0xffff
+#define ORBIS_SO_NBIO 0x1200
+
+/*
+ * Orbis may apply F_SETFL and still return -1 with EACCES.  Verify the
+ * descriptor state before reporting failure so callers observe the actual
+ * result of the operation.
+ *
+ * The file flag is not the socket's own mode, though: after that EACCES a UDP
+ * recvfrom on a descriptor whose F_GETFL shows O_NONBLOCK still blocked
+ * forever (DatagramChannel.connect's queue drain, under JNDI DNS).  So the
+ * socket is also set through FIONBIO, which is what F_SETFL is meant to
+ * forward, and orbis_nonblocking_flags() lets receive paths add MSG_DONTWAIT
+ * per call in case the socket refuses that as well.
+ */
+static int
+orbis_configure_blocking(int fd, int blocking)
+{
+    int flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        return -1;
+    }
+    {
+        /*
+         * Neither switch alone made a TCP connect non-blocking: Netty's connects
+         * to unreachable servers blocked their event loops, freezing every
+         * server ping.  Non-socket descriptors just fail these calls.
+         */
+        int nbio = blocking ? 0 : 1;
+        (void)ioctl(fd, ORBIS_FIONBIO, &nbio);
+        (void)setsockopt(fd, ORBIS_SOL_SOCKET, ORBIS_SO_NBIO, &nbio, sizeof(nbio));
+    }
+
+    int requested_flags = blocking
+            ? (flags & ~O_NONBLOCK)
+            : (flags | O_NONBLOCK);
+    if (flags == requested_flags) {
+        return 0;
+    }
+    if (fcntl(fd, F_SETFL, requested_flags) == 0) {
+        return 0;
+    }
+
+    int saved_errno = errno;
+    int actual_flags = fcntl(fd, F_GETFL);
+    if (actual_flags >= 0 &&
+            (actual_flags & O_NONBLOCK) == (requested_flags & O_NONBLOCK)) {
+        return 0;
+    }
+
+    errno = saved_errno;
+    return -1;
+}
+
+/* MSG_DONTWAIT when fd is meant to be non-blocking, for recv-family calls. */
+static int
+orbis_nonblocking_flags(int fd)
+{
+    int flags = fcntl(fd, F_GETFL);
+    return (flags >= 0 && (flags & O_NONBLOCK) != 0) ? ORBIS_MSG_DONTWAIT : 0;
+}
