+
+static bool orbis_vm_map_trace_requested() {
+  static volatile int state = 0;  // 0 unchecked, 1 checking, 2 enabled, -1 off
+  int current = __atomic_load_n(&state, __ATOMIC_ACQUIRE);
+  if (current == 0) {
+    int expected = 0;
+    if (__atomic_compare_exchange_n(&state, &expected, 1, false,
+                                    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+      const char* marker_path = "/data/orbis-jdk/runner/vmmap-probe.txt";
+      int fd = ::open(marker_path, O_RDONLY);
+      char marker[8] = {0};
+      ssize_t length = fd < 0 ? -1 : ::read(fd, marker, sizeof(marker) - 1);
+      if (fd >= 0) ::close(fd);
+      bool enabled = length >= 0 &&
+          (strcmp(marker, "run") == 0 || strcmp(marker, "run\n") == 0) &&
+          ::unlink(marker_path) == 0;
+      __atomic_store_n(&state, enabled ? 2 : -1, __ATOMIC_RELEASE);
+      return enabled;
+    }
+    return false;
+  }
+  return current == 2;
+}
+
+void orbis_vm_map_trace(const char* operation, uintptr_t requested,
+                        uintptr_t result, size_t size, int prot, int flags,
+                        int error, uintptr_t caller, bool success) {
+  if (!orbis_vm_map_trace_requested()) return;
+  // Keep medium-sized mappings in the diagnostic: Paper creates useful
+  // regions below 1 MiB, while smaller page-sized churn would overwhelm the
+  // per-process log and obscure the reservations relevant to this probe.
+  if (success && size < 64 * 1024) return;
+
+  static volatile uint32_t success_count = 0;
+  static volatile uint32_t failure_count = 0;
+  static volatile uint32_t commit_success_events = 0;
+  static volatile uint32_t commit_summary_written = 0;
+  if (success && strncmp(operation, "commit-", 7) == 0) {
+    __atomic_add_fetch(&commit_success_events, 1, __ATOMIC_RELAXED);
+    return;
+  }
+  if (!success &&
+      __atomic_exchange_n(&commit_summary_written, 1, __ATOMIC_RELAXED) == 0) {
+    char summary[112];
+    uint32_t commits = __atomic_load_n(&commit_success_events, __ATOMIC_RELAXED);
+    jio_snprintf(summary, sizeof(summary),
+                 "orbis-vmmap op=commit-successes-suppressed count=%u\n",
+                 commits);
+    sceKernelDebugOutText(0, summary);
+  }
+  volatile uint32_t* count = success ? &success_count : &failure_count;
+  const uint32_t limit = success ? 1024 : 256;
+  uint32_t previous = __atomic_fetch_add(count, 1, __ATOMIC_RELAXED);
+  if (previous >= limit) {
+    if (previous == limit) {
+      char limit_line[96];
+      jio_snprintf(limit_line, sizeof(limit_line),
+                   "orbis-vmmap op=trace-limit-reached class=%s limit=%u\n",
+                   success ? "success" : "failure", limit);
+      sceKernelDebugOutText(0, limit_line);
+    }
+    return;
+  }
+
+  char line[320];
+  jio_snprintf(line, sizeof(line),
+               "orbis-vmmap op=%s success=%d requested=0x%" PRIxPTR
+               " result=0x%" PRIxPTR " size=%" PRIuPTR
+               " prot=0x%x flags=0x%x errno=%d caller=0x%" PRIxPTR "\n",
+               operation, success ? 1 : 0, requested, result,
+               (uintptr_t)size, prot, flags, error, caller);
+  sceKernelDebugOutText(0, line);
+}
+
+// Reservation and commit failures are useful even when the optional vmmap
+// marker is not installed.  Keep this path failure-only and bounded: normal
+// Java startup must remain quiet on UART.
+static void orbis_vm_map_failure(const char* operation, uintptr_t requested,
+                                 size_t size, int error, bool exec) {
+  static volatile uint32_t failure_count = 0;
+  uint32_t previous = __atomic_fetch_add(&failure_count, 1, __ATOMIC_RELAXED);
+  if (previous >= 64) return;
+  char line[256];
+  jio_snprintf(line, sizeof(line),
+               "orbis-vm-failure op=%s requested=0x%" PRIxPTR
+               " size=%" PRIuPTR " exec=%d errno=%d (%s)\n",
+               operation, requested, (uintptr_t)size, exec ? 1 : 0,
+               error, os::errno_name(error));
+  sceKernelDebugOutText(0, line);
+}
+
+// NOTE: Bsd kernel does not really reserve the pages for us.
+//       All it does is to check if there are enough free pages
+//       left at the time of mmap(). This could be a potential
+//       problem.
+bool os::pd_commit_memory(char* addr, size_t size, bool exec) {
+  if (!exec) {
+    void* outer = NULL;
+    size_t direct_size = 0;
+    if (orbis_direct_memory_find_user_ptr(addr, &outer, &direct_size)) {
+      // sceKernelMapDirectMemory returns a read/write mapping already. Keep
+      // it intact instead of replacing it with MAP_FIXED.
+      return true;
+    }
+  }
+  int prot = exec ? PROT_READ|PROT_WRITE|PROT_EXEC : PROT_READ|PROT_WRITE;
+  bool success = false;
+  int error = 0;
+  if (exec) {
+    // Do not replace MAP_JIT mappings, see JDK-8234930
+    if (::mprotect(addr, size, prot) == 0) {
+      success = true;
+    } else {
+      error = errno;
+    }
+  } else if (::mprotect(addr, size, prot) == 0) {
+    // Committing inside the PROT_NONE reservation keeps one backing object, so adjacent
+    // committed ranges merge into one map entry. A fresh MAP_FIXED mapping per commit made each
+    // 64 KiB Metaspace granule its own entry for the life of the process (532 of 851 entries
+    // 13 s into a Minecraft start), and Orbis refuses new mappings - thread stacks included,
+    // as EAGAIN - once a process holds too many. Pages are zero: they come from the original
+    // anonymous reservation, or from the fresh one pd_uncommit_memory maps over them.
+    success = true;
+  } else {
+    uintptr_t res = (uintptr_t) ::mmap(addr, size, prot,
+                                       MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS, -1, 0);
+    if (res != (uintptr_t) MAP_FAILED) {
+      success = true;
+    } else {
+      error = errno;
+    }
+  }
+  orbis_vm_map_trace(exec ? "commit-mprotect" : "commit-mmap-fixed",
+                     (uintptr_t)addr, success ? (uintptr_t)addr : 0,
+                     size, prot,
+                     exec ? 0 : MAP_PRIVATE|MAP_FIXED|MAP_ANONYMOUS,
+                     error, (uintptr_t)__builtin_return_address(0), success);
+  if (!success) {
+    errno = error;
+    orbis_vm_map_failure(exec ? "commit-mprotect" : "commit-mmap-fixed",
+                         (uintptr_t)addr, size, error, exec);
+  }
+  return success;
+}
