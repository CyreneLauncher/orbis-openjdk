+    int digits = 0;
+    int count = 0;
+    const char *p = name;
+
+    while (*p != '\0') {
+        if (*p >= '0' && *p <= '9') {
+            octet = octet * 10U + (unsigned int)(*p - '0');
+            if (octet > 255U)
+                return -1;
