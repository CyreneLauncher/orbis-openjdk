+                                     5000000, 3, 0);
+    if (status < 0) {
+        snprintf(error_detail, error_detail_size,
+                 "%s (DNS lookup failed: 0x%08x)",
+                 hostname, (unsigned int)status);
+        fprintf(stderr, "orbis-net: DNS lookup failed for %s: 0x%08x\n",
+                hostname, (unsigned int)status);
+    }
+    {
+        int destroy_status = sceNetResolverDestroy(resolver);
+        if (destroy_status < 0) {
+            fprintf(stderr, "orbis-net: DNS resolver destroy failed: 0x%08x\n",
+                    (unsigned int)destroy_status);
+        }
+    }
+    if (status < 0)
+        return status;
+    *address = sceNetNtohl(result.s_addr);
+    return 0;
+}
