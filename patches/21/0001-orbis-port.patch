+static const char* orbis_runtime_java_home() {
+  const char* java_home = ::getenv("ORBIS_JAVA_HOME");
+  if (java_home == NULL || java_home[0] != '/') {
+    sceKernelDebugOutText(0, "orbis-jvm: ORBIS_JAVA_HOME must be set to an absolute path before VM initialization\n");
+    vm_exit_during_initialization("ORBIS_JAVA_HOME must be set to an absolute path before VM initialization.", NULL);
+  }
+  if (strlen(java_home) > MAXPATHLEN - sizeof("/lib/server/libjvm.prx")) {
+    sceKernelDebugOutText(0, "orbis-jvm: ORBIS_JAVA_HOME is too long\n");
+    vm_exit_during_initialization("ORBIS_JAVA_HOME is too long.", NULL);
