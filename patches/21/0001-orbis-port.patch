+//////////////////////////////////////////////////////////////////////////////
+// create new thread
+
+#ifdef __APPLE__
+// library handle for calling objc_registerThreadWithCollector()
+// without static linking to the libobjc library
+  #define OBJC_LIB "/usr/lib/libobjc.dylib"
+  #define OBJC_GCREGISTER "objc_registerThreadWithCollector"
+typedef void (*objc_registerThreadWithCollector_t)();
+extern "C" objc_registerThreadWithCollector_t objc_registerThreadWithCollectorFunction;
+objc_registerThreadWithCollector_t objc_registerThreadWithCollectorFunction = nullptr;
+#endif
+
+// Releases the calling thread's libjvm thread-locals (orbis-export/tools/orbis_prx_tls.c).
+extern "C" void orbis_prx_tls_thread_exit(void);
+
+// Thread start routine for all newly created threads
+static void *thread_native_entry(void* stack_slot_arg) {
+  const int stack_slot = static_cast<int>(reinterpret_cast<uintptr_t>(
+      stack_slot_arg)) - 1;
+  Thread* thread = reinterpret_cast<Thread*>(
+      orbis_thread_stack_registry.thread_for_slot(stack_slot));
+  if (thread == NULL) return NULL;
+
+  thread->record_stack_base_and_size();
+  thread->initialize_thread_current();
+
+  OSThread* osthread = thread->osthread();
+  Monitor* sync = osthread->startThread_lock();
+
+  osthread->set_thread_id(os::Bsd::gettid());
+
+#ifdef __APPLE__
+  // Store unique OS X thread id used by SA
+  osthread->set_unique_thread_id();
+#endif
+
+  // initialize signal mask for this thread
+  PosixSignals::hotspot_sigmask(thread);
+
+  // initialize floating point control register
+  os::Bsd::init_thread_fpu_state();
+
+#ifdef __APPLE__
+  // register thread with objc gc
+  if (objc_registerThreadWithCollectorFunction != nullptr) {
+    objc_registerThreadWithCollectorFunction();
+  }
+#endif
+
+  // handshaking with parent thread
+  {
+    MutexLocker ml(sync, Mutex::_no_safepoint_check_flag);
+
+    // notify parent thread
+    osthread->set_state(INITIALIZED);
+    sync->notify_all();
+
+    // wait until os::start_thread()
+    while (osthread->get_state() == INITIALIZED) {
+      sync->wait_without_safepoint_check();
+    }
+  }
+
+  log_info(os, thread)("Thread is alive (tid: " UINTX_FORMAT ", pthread id: " UINTX_FORMAT ").",
+    os::current_thread_id(), (uintx) pthread_self());
+
+  // call one more level start routine
+  thread->call_run();
+
+  // Note: at this point the thread object may already have deleted itself.
+  // Prevent dereferencing it from here on out.
+  thread = nullptr;
+
+  log_info(os, thread)("Thread finished (tid: " UINTX_FORMAT ", pthread id: " UINTX_FORMAT ").",
+    os::current_thread_id(), (uintx) pthread_self());
+
+  // The thread-local storage table is keyed by pthread_self(), which a later thread can reuse:
+  // never leave this thread's entry behind, whatever path the Thread took out of call_run.
+  ThreadLocalStorage::set_thread(NULL);
+
+  orbis_thread_stack_registry.complete(stack_slot);
+
+  // Last: this thread's block of libjvm thread-locals (orbis_prx_tls.c) has no destructor.
+  orbis_prx_tls_thread_exit();
+
+  return 0;
+}
+
+bool os::create_thread(Thread* thread, ThreadType thr_type,
+                       size_t req_stack_size) {
+  orbis_enroll_flexible_memory_reporter();
+  assert(thread->osthread() == nullptr, "caller responsible");
+
+  orbis_reap_thread_stacks();
+
+  // Allocate the OSThread object
+  OSThread* osthread = new (std::nothrow) OSThread();
+  if (osthread == nullptr) {
+    return false;
+  }
+
+  // set the correct thread state
+  osthread->set_thread_type(thr_type);
+
+  // Initial state is ALLOCATED but not INITIALIZED
+  osthread->set_state(ALLOCATED);
+
+  thread->set_osthread(osthread);
+
+  // init thread attributes
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+
+  // calculate stack size if it's not specified by caller
+  size_t stack_size = os::Posix::get_initial_stack_size(thr_type, req_stack_size);
+  void* stack_mapping = NULL;
+  size_t stack_mapping_size = 0;
+  off_t stack_direct_offset = 0;
+  void* stack_base = NULL;
+  if (!orbis_allocate_thread_stack(stack_size, &stack_mapping,
+                                   &stack_mapping_size,
+                                   &stack_direct_offset, &stack_base)) {
+    pthread_attr_destroy(&attr);
+    thread->set_osthread(NULL);
+    delete osthread;
+    return false;
+  }
+  const int stack_slot = orbis_thread_stack_registry.reserve(
+      stack_mapping, stack_mapping_size, (uint64_t)stack_direct_offset, thread);
+  if (stack_slot < 0) {
+    char line[128];
+    jio_snprintf(line, sizeof(line),
+                 "orbis-jvm: thread stack registry full (%d slots)\n",
+                 ORBIS_THREAD_STACK_CAPACITY);
+    sceKernelDebugOutText(0, line);
+    orbis_release_thread_stack(stack_mapping, stack_mapping_size,
+                               stack_direct_offset);
+    pthread_attr_destroy(&attr);
+    thread->set_osthread(NULL);
+    delete osthread;
+    return false;
+  }
+
+  int status = pthread_attr_setstack(&attr, stack_base, stack_size);
+  if (status != 0) {
+    assert_status(status == EINVAL, status, "pthread_attr_setstack");
+    log_warning(os, thread)("The %sthread stack size specified is invalid: " SIZE_FORMAT "k",
+                            (thr_type == compiler_thread) ? "compiler " : ((thr_type == java_thread) ? "" : "VM "),
+                            stack_size / K);
+    orbis_thread_stack_registry.finish_reap(stack_slot);
+    orbis_release_thread_stack(stack_mapping, stack_mapping_size,
+                               stack_direct_offset);
+    pthread_attr_destroy(&attr);
+    thread->set_osthread(nullptr);
+    delete osthread;
+    pthread_attr_destroy(&attr);
+    return false;
+  }
+
+  ThreadState state;
+
+  {
+
+    ResourceMark rm;
+    pthread_t tid;
+    int ret = 0;
+    int limit = 3;
+    do {
+      ret = pthread_create(&tid, &attr, thread_native_entry,
+                           reinterpret_cast<void*>((uintptr_t)stack_slot + 1));
+    } while (ret == EAGAIN && limit-- > 0);
+
+    char buf[64];
+    if (ret == 0) {
+      log_info(os, thread)("Thread \"%s\" started (pthread id: " UINTX_FORMAT ", attributes: %s). ",
+                           thread->name(), (uintx) tid, os::Posix::describe_pthread_attr(buf, sizeof(buf), &attr));
+    } else {
+      log_warning(os, thread)("Failed to start thread \"%s\" - pthread_create failed (%s) for attributes: %s.",
+                              thread->name(), os::errno_name(ret), os::Posix::describe_pthread_attr(buf, sizeof(buf), &attr));
+      // Log some OS information which might explain why creating the thread failed.
+      log_info(os, thread)("Number of threads approx. running in the VM: %d", Threads::number_of_threads());
+      LogStream st(Log(os, thread)::info());
+      os::Posix::print_rlimit_info(&st);
+      os::print_memory_info(&st);
+    }
+
+    pthread_attr_destroy(&attr);
+
+    if (ret != 0) {
+      // Need to clean up stuff we've allocated so far
+      orbis_thread_stack_registry.finish_reap(stack_slot);
+      orbis_release_thread_stack(stack_mapping, stack_mapping_size,
+                                 stack_direct_offset);
+      thread->set_osthread(nullptr);
+      delete osthread;
+      return false;
+    }
+
+    orbis_thread_stack_registry.publish(stack_slot, (uintptr_t)tid);
+
+    // Store pthread info into the OSThread
+    osthread->set_pthread_id(tid);
+
+    // Wait until child thread is either initialized or aborted
+    {
+      Monitor* sync_with_child = osthread->startThread_lock();
+      MutexLocker ml(sync_with_child, Mutex::_no_safepoint_check_flag);
+      while ((state = osthread->get_state()) == ALLOCATED) {
+        sync_with_child->wait_without_safepoint_check();
+      }
+    }
+
+  }
+
+  // The thread is returned suspended (in state INITIALIZED),
+  // and is started higher up in the call chain
+  assert(state == INITIALIZED, "race condition");
+  return true;
+}
