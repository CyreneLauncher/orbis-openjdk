+package sun.font;
+import java.awt.Font;
+import java.io.File;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.HashSet;
+import sun.awt.FontConfiguration;
+import sun.awt.FontDescriptor;
+/** Logical fonts use the bundled Unicode baseline with synthetic styles. */
+final class OrbisFontConfiguration extends FontConfiguration {
+    OrbisFontConfiguration(SunFontManager manager) { super(manager); }
+    @Override public synchronized boolean init() {
+        File font = new File(OrbisFontManager.baselineFont());
+        if (!font.isAbsolute() || !font.isFile()) {
+            throw new InternalError("Missing bundled Orbis font: " + font);
+        }
+        setFontConfiguration();
+        return true;
+    }
+    @Override public boolean fontFilesArePresent() {
+        return new File(OrbisFontManager.baselineFont()).isFile();
+    }
+    @Override public CompositeFontDescriptor[] get2DCompositeFontInfo() {
+        String[] families = {"serif", "sansserif", "monospaced", "dialog", "dialoginput"};
+        CompositeFontDescriptor[] descriptors = new CompositeFontDescriptor[20];
+        int i = 0;
+        for (String family : families) {
+            for (int style = Font.PLAIN; style <= (Font.BOLD | Font.ITALIC); style++) {
+                descriptors[i++] = new CompositeFontDescriptor(
+                    family + "." + getStyleString(style), 1,
+                    new String[] {"DejaVu Sans"},
+                    new String[] {OrbisFontManager.baselineFont()},
+                    new int[0], new int[] {0});
+            }
+        }
+        return descriptors;
+    }
+    @Override public String[] getPlatformFontNames() { return new String[] {"DejaVu Sans"}; }
+    @Override public int getNumberCoreFonts() { return 1; }
+    @Override public String getFileNameFromPlatformName(String name) { return OrbisFontManager.baselineFont(); }
+    @Override public String getExtraFontPath() { return null; }
+    @Override public String getVersion() { return "1"; }
+    @Override public boolean needToSearchForFile(String file) { return false; }
+    @Override public HashSet<String> getAWTFontPathSet() {
+        return new HashSet<>(java.util.List.of(SunFontManager.getJDKFontDir()));
+    }
+    @Override public FontDescriptor[] getFontDescriptors(String name, int style) {
+        return new FontDescriptor[] {new FontDescriptor("DejaVu Sans",
+            StandardCharsets.UTF_8.newEncoder(), new int[0])};
+    }
+    @Override public String getFallbackFamilyName(String name, String fallback) { return fallback; }
+    @Override protected void initReorderMap() { reorderMap = new HashMap<>(); }
+    @Override protected String getEncoding(String font, String subset) { return "UTF-8"; }
+    @Override protected Charset getDefaultFontCharset(String name) { return StandardCharsets.UTF_8; }
+    @Override protected String getFaceNameFromComponentFontName(String name) { return "DejaVu Sans"; }
+    @Override protected String getFileNameFromComponentFontName(String name) { return OrbisFontManager.baselineFont(); }
+}
