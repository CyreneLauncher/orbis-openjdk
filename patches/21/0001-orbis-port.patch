+++ b/test/orbis/test-lcms-wchar-abi.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Check LCMS wide literals against the SDK wchar_t using configured flags."""
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[2]
+command = root / 'build/orbis-x86_64-server-release/support/native/java.desktop/liblcms/cmsvirt.o.cmdline'
+flags = []
+skip = False
+for arg in shlex.split(command.read_text()):
+    if skip:
+        skip = False
+        continue
+    if arg in ('-MF', '-o'):
+        skip = True
+        continue
+    if arg in ('-MMD', '-c') or arg.endswith('.c'):
+        continue
+    flags.append(arg)
+with tempfile.TemporaryDirectory() as tmp:
+    source = Path(tmp) / 'wchar-abi.c'
+    source.write_text('''#include <wchar.h>
+_Static_assert(sizeof(wchar_t) == 2, "SDK wchar_t ABI");
+_Static_assert(sizeof(L"AB"[0]) == sizeof(wchar_t), "wide literal differs from SDK ABI");
+_Static_assert(__builtin_types_compatible_p(__typeof__(L"AB"), wchar_t[3]), "wide literal element type");
+''')
+    subprocess.run(flags + ['-fsyntax-only', str(source)], check=True)
+print('LCMS wide literals match the SDK 16-bit wchar_t ABI')
