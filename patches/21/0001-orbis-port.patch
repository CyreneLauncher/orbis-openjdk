+// The calling thread's slot, or NULL.
+static TlsSlot* tls_find(uintptr_t self) {
+  size_t i = tls_home(self);
+  for (size_t n = 0; n < TLS_SLOTS; n++, i = (i + 1) & (TLS_SLOTS - 1)) {
+    uintptr_t key = Atomic::load_acquire(&_tls_slots[i].key);
+    if (key == self) return &_tls_slots[i];
+    if (key == TLS_EMPTY) return NULL;
+  }
+  return NULL;
