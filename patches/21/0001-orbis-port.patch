@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Exercise the production direct realloc branch with NMT footer canaries."""
+from pathlib import Path
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[2]
+source = (root / 'src/hotspot/share/runtime/os.cpp').read_text()
+start = source.index('  void* direct_outer = nullptr;', source.index('void* os::realloc'))
+branch = source[start:source.index('#endif', start)]
+fixture = r'''
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+#include <cstdlib>
+#define MIN2(a,b) std::min((a),(b))
+#undef assert
+#define assert(cond, ...) do { if (!(cond)) std::abort(); } while(0)
+static unsigned char old_block[26]; // 8 byte header, 16 byte payload, 2 byte footer
+static unsigned char replacement_block[32];
+static bool fail_alloc = false, freed = false, nmt = true;
+struct MemTracker { static bool enabled() { return nmt; } };
+struct MallocHeader {
+ static MallocHeader* resolve_checked(void*) { static MallocHeader h; return &h; }
+ size_t size() const { return 16; }
+};
+namespace os {
+ void* malloc(size_t, int, int) { return fail_alloc ? nullptr : replacement_block; }
+ void free(void*) { freed = true; }
+}
+bool orbis_direct_memory_find_user_ptr(void*, void** outer, size_t* size) {
+ *outer = old_block; *size = sizeof(old_block); return true;
+}
+void* exercise(void* memblock, size_t size) {
+ int memflags = 0, stack = 0;
+''' + branch + r'''
+ return nullptr;
+}
+int main() {
+ std::memset(old_block + 8, 0x42, 16);
+ old_block[24] = 0xde; old_block[25] = 0xad;
+ std::memset(replacement_block, 0xa5, sizeof(replacement_block));
+ assert(exercise(old_block + 8, 32) == replacement_block);
+ assert(freed);
+ for (int i=0; i<16; ++i) assert(replacement_block[i] == 0x42);
+ assert(replacement_block[16] == 0xa5); // allocator footer must not become payload
+ fail_alloc = true; freed = false;
+ assert(exercise(old_block + 8, 32) == nullptr);
+ assert(!freed); assert(old_block[8] == 0x42);
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+    path = Path(tmp)
+    (path / 'check.cpp').write_text(fixture)
+    subprocess.run(['c++', '-std=c++17', str(path / 'check.cpp'), '-o', str(path / 'check')], check=True)
+    subprocess.run([str(path / 'check')], check=True)
+print('Direct realloc preserves payload boundaries and old allocation on failure')
