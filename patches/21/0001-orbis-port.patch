+#ifdef AMD64
+address os::current_stack_pointer() {
+  return (address)__builtin_frame_address(0);
+}
+#else
+address os::current_stack_pointer() __attribute__ ((optnone)) {
+  intptr_t* esp;
+  __asm__ __volatile__ ("mov %%" SPELL_REG_SP ", %0":"=r"(esp):);
+  return (address) esp;
+}
+#endif
+
+// The SDK's public ucontext_t exposes a Linux-shaped compatibility layout.
+// The PS4 signal frame uses the native layout established by the hardware
+// probe: mcontext starts at ucontext+0x40, RIP is at +0xe0, and RSP is at
+// +0xf8. Keep the prefix explicit so a future SDK header change cannot silently
+// move the frame-pointer access back to the public gregs view.
+struct OrbisNativeMContextPrefix {
+  uint64_t mc_onstack;
+  uint64_t mc_rdi;
+  uint64_t mc_rsi;
+  uint64_t mc_rdx;
+  uint64_t mc_rcx;
+  uint64_t mc_r8;
+  uint64_t mc_r9;
+  uint64_t mc_rax;
+  uint64_t mc_rbx;
+  uint64_t mc_rbp;
+  uint64_t mc_r10;
+  uint64_t mc_r11;
+  uint64_t mc_r12;
+  uint64_t mc_r13;
+  uint64_t mc_r14;
+  uint64_t mc_r15;
+  int32_t  mc_trapno;
+  uint16_t mc_fs;
+  uint16_t mc_gs;
+  uint64_t mc_addr;
+  int32_t  mc_flags;
+  uint16_t mc_es;
+  uint16_t mc_ds;
+  uint64_t mc_err;
+  uint64_t mc_rip;
+  uint64_t mc_cs;
+  uint64_t mc_rflags;
+  uint64_t mc_rsp;
+  uint64_t mc_ss;
+};
+
+static_assert(offsetof(OrbisNativeMContextPrefix, mc_rbp) == 0x48,
+              "unexpected Orbis mcontext RBP offset");
+static_assert(offsetof(OrbisNativeMContextPrefix, mc_rip) == 0xa0,
+              "unexpected Orbis mcontext RIP offset");
+static_assert(offsetof(OrbisNativeMContextPrefix, mc_rsp) == 0xb8,
+              "unexpected Orbis mcontext RSP offset");
+
+static inline const OrbisNativeMContextPrefix* orbis_native_mcontext(
+    const ucontext_t* uc) {
+  return reinterpret_cast<const OrbisNativeMContextPrefix*>(
+      reinterpret_cast<const char*>(uc) + 0x40);
+}
+
+static inline OrbisNativeMContextPrefix* orbis_native_mcontext(ucontext_t* uc) {
+  return reinterpret_cast<OrbisNativeMContextPrefix*>(
+      reinterpret_cast<char*>(uc) + 0x40);
+}
+
+static inline intptr_t orbis_context_pc(const ucontext_t* uc) {
+  return static_cast<intptr_t>(orbis_native_mcontext(uc)->mc_rip);
+}
+
+static inline void orbis_context_set_pc(ucontext_t* uc, intptr_t pc) {
+  orbis_native_mcontext(uc)->mc_rip = static_cast<uint64_t>(pc);
+}
+
+static inline intptr_t* orbis_context_sp(const ucontext_t* uc) {
+  return reinterpret_cast<intptr_t*>(orbis_native_mcontext(uc)->mc_rsp);
+}
+
+static inline intptr_t* orbis_context_fp(const ucontext_t* uc) {
+  return reinterpret_cast<intptr_t*>(orbis_native_mcontext(uc)->mc_rbp);
+}
+
+char* os::non_memory_address_word() {
+  // Must never look like an address returned by reserve_memory,
+  // even in its subfields (as defined by the CPU immediate fields,
+  // if the CPU splits constants across multiple instructions).
+
+  return (char*) -1;
+}
