new file mode 100644
index 000000000..c912a986a
--- /dev/null
+++ b/src/hotspot/os/orbis/orbis_stat.hpp
@@ -0,0 +1,102 @@
+/*
+ * Copyright (c) 2026, OpenJDK contributors. All rights reserved.
+ * DO NOT ALTER OR REMOVE COPYRIGHT NOTICES OR THIS FILE HEADER.
+ *
+ * This code is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation.
+ *
+ * This code is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * version 2 for more details (a copy is included in the LICENSE file that
+ * accompanied this code).
+ */
+
+#ifndef OS_ORBIS_ORBIS_STAT_HPP
+#define OS_ORBIS_ORBIS_STAT_HPP
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+
+// libkernel uses 16-bit mode and link counts, unlike the SDK struct stat.
+// Read its ABI into explicit storage before copying into compiler fields.
+typedef struct OrbisNativeStat {
+    uint32_t dev;
+    uint32_t ino;
+    uint16_t mode;
+    uint16_t nlink;
+    uint32_t uid;
+    uint32_t gid;
+    uint32_t rdev;
+    struct timespec atim;
+    struct timespec mtim;
+    struct timespec ctim;
+    int64_t size;
+    int64_t blocks;
+    uint32_t blksize;
+    uint32_t flags;
+    uint32_t gen;
+    int32_t lspare;
+    struct timespec birthtim;
+} OrbisNativeStat;
+
+static_assert(sizeof(OrbisNativeStat) == 120, "Orbis stat ABI size");
+static_assert(offsetof(OrbisNativeStat, dev) == 0, "Orbis st_dev ABI offset");
+static_assert(offsetof(OrbisNativeStat, ino) == 4, "Orbis st_ino ABI offset");
+static_assert(offsetof(OrbisNativeStat, mode) == 8, "Orbis st_mode ABI offset");
+static_assert(offsetof(OrbisNativeStat, nlink) == 10, "Orbis st_nlink ABI offset");
+static_assert(offsetof(OrbisNativeStat, uid) == 12, "Orbis st_uid ABI offset");
+static_assert(offsetof(OrbisNativeStat, gid) == 16, "Orbis st_gid ABI offset");
+static_assert(offsetof(OrbisNativeStat, rdev) == 20, "Orbis st_rdev ABI offset");
+static_assert(offsetof(OrbisNativeStat, atim) == 24, "Orbis st_atim ABI offset");
+static_assert(offsetof(OrbisNativeStat, mtim) == 40, "Orbis st_mtim ABI offset");
+static_assert(offsetof(OrbisNativeStat, ctim) == 56, "Orbis st_ctim ABI offset");
+static_assert(offsetof(OrbisNativeStat, size) == 72, "Orbis st_size ABI offset");
+static_assert(offsetof(OrbisNativeStat, blocks) == 80, "Orbis st_blocks ABI offset");
+static_assert(offsetof(OrbisNativeStat, blksize) == 88, "Orbis st_blksize ABI offset");
+static_assert(offsetof(OrbisNativeStat, flags) == 92, "Orbis st_flags ABI offset");
+static_assert(offsetof(OrbisNativeStat, gen) == 96, "Orbis st_gen ABI offset");
+static_assert(offsetof(OrbisNativeStat, lspare) == 100,
+               "Orbis st_lspare ABI offset");
+static_assert(offsetof(OrbisNativeStat, birthtim) == 104,
+               "Orbis st_birthtim ABI offset");
+
+static inline void orbis_copy_stat(const OrbisNativeStat& native, struct stat* result) {
+  memset(result, 0, sizeof(*result));
+  result->st_dev = native.dev;
+  result->st_ino = native.ino;
+  result->st_mode = native.mode;
+  result->st_nlink = native.nlink;
+  result->st_uid = native.uid;
+  result->st_gid = native.gid;
+  result->st_rdev = native.rdev;
+  result->st_atim = native.atim;
+  result->st_mtim = native.mtim;
+  result->st_ctim = native.ctim;
+  result->st_size = native.size;
+  result->st_blocks = native.blocks;
+  result->st_blksize = native.blksize;
+  result->st_flags = native.flags;
+  result->st_gen = native.gen;
+  result->st_birthtim = native.birthtim;
+}
+
+static inline int orbis_stat(const char* path, struct stat* result) {
+  OrbisNativeStat native;
+  int status = ::stat(path, reinterpret_cast<struct stat*>(&native));
+  if (status == 0) orbis_copy_stat(native, result);
+  return status;
+}
+
+static inline int orbis_fstat(int fd, struct stat* result) {
+  OrbisNativeStat native;
+  int status = ::fstat(fd, reinterpret_cast<struct stat*>(&native));
+  if (status == 0) orbis_copy_stat(native, result);
+  return status;
+}
+
+#endif // OS_ORBIS_ORBIS_STAT_HPP
diff --git a/src/hotspot/os/orbis/orbis_thread_stack_registry.hpp b/src/hotspot/os/orbis/orbis_thread_stack_registry.hpp
new file mode 100644
index 000000000..1b6429ed3
--- /dev/null
+++ b/src/hotspot/os/orbis/orbis_thread_stack_registry.hpp
@@ -0,0 +1,130 @@
+/*
+ * Copyright (c) 2026, OpenOrbis contributors.
+ * SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+ */
+
+#ifndef OS_ORBIS_ORBIS_THREAD_STACK_REGISTRY_HPP
+#define OS_ORBIS_ORBIS_THREAD_STACK_REGISTRY_HPP
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct OrbisRetiredThreadStack {
+  int slot;
+  uintptr_t thread_id;
+  void* mapping;
+  size_t mapping_size;
+  uint64_t direct_offset;
+  void* thread;
+};
+
+template <size_t Capacity>
+class OrbisThreadStackRegistry {
+ private:
+  enum State {
+    FREE = 0,
+    PREPARING = 1,
+    PREPARED = 2,
+    RUNNING = 3,
+    COMPLETED = 4,
+    REAPING = 5
+  };
+
+  struct Record {
+    volatile int state;
+    uintptr_t thread_id;
+    void* mapping;
+    size_t mapping_size;
+    uint64_t direct_offset;
+    void* thread;
+  };
+
+  Record _records[Capacity];
+
+ public:
+  void initialize() {
+    for (size_t i = 0; i < Capacity; ++i) {
+      __atomic_store_n(&_records[i].state, FREE, __ATOMIC_RELAXED);
+      _records[i].thread_id = 0;
+      _records[i].mapping = NULL;
+      _records[i].mapping_size = 0;
+      _records[i].direct_offset = 0;
+      _records[i].thread = NULL;
+    }
+  }
+
+  int reserve(void* mapping, size_t mapping_size, uint64_t direct_offset,
+              void* thread) {
+    for (size_t i = 0; i < Capacity; ++i) {
+      int expected = FREE;
+      if (__atomic_compare_exchange_n(&_records[i].state, &expected,
+                                      PREPARING, false, __ATOMIC_ACQUIRE,
+                                      __ATOMIC_RELAXED)) {
+        _records[i].thread_id = 0;
+        _records[i].mapping = mapping;
+        _records[i].mapping_size = mapping_size;
+        _records[i].direct_offset = direct_offset;
+        _records[i].thread = thread;
+        __atomic_store_n(&_records[i].state, PREPARED, __ATOMIC_RELEASE);
+        return static_cast<int>(i);
+      }
+    }
+    return -1;
+  }
+
+  void publish(int slot, uintptr_t thread_id) {
+    if (slot < 0 || static_cast<size_t>(slot) >= Capacity) return;
+    _records[slot].thread_id = thread_id;
+    int expected = PREPARED;
+    __atomic_compare_exchange_n(&_records[slot].state, &expected, RUNNING,
+                                false, __ATOMIC_RELEASE, __ATOMIC_ACQUIRE);
+  }
+
+  void* thread_for_slot(int slot) const {
+    if (slot < 0 || static_cast<size_t>(slot) >= Capacity) return NULL;
+    return _records[slot].thread;
+  }
+
+  void complete(int slot) {
+    if (slot < 0 || static_cast<size_t>(slot) >= Capacity) return;
+    int state = __atomic_load_n(&_records[slot].state, __ATOMIC_ACQUIRE);
+    while (state == PREPARED || state == RUNNING) {
+      if (__atomic_compare_exchange_n(&_records[slot].state, &state,
+                                      COMPLETED, false, __ATOMIC_RELEASE,
+                                      __ATOMIC_ACQUIRE)) {
+        return;
+      }
+    }
+  }
+
+  bool take_completed(OrbisRetiredThreadStack* retired) {
+    if (retired == NULL) return false;
+    for (size_t i = 0; i < Capacity; ++i) {
+      int expected = COMPLETED;
+      if (__atomic_compare_exchange_n(&_records[i].state, &expected, REAPING,
+                                      false, __ATOMIC_ACQUIRE,
+                                      __ATOMIC_RELAXED)) {
+        retired->slot = static_cast<int>(i);
+        retired->thread_id = _records[i].thread_id;
+        retired->mapping = _records[i].mapping;
+        retired->mapping_size = _records[i].mapping_size;
+        retired->direct_offset = _records[i].direct_offset;
+        retired->thread = _records[i].thread;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void finish_reap(int slot) {
+    if (slot < 0 || static_cast<size_t>(slot) >= Capacity) return;
+    _records[slot].thread_id = 0;
+    _records[slot].mapping = NULL;
+    _records[slot].mapping_size = 0;
+    _records[slot].direct_offset = 0;
+    _records[slot].thread = NULL;
+    __atomic_store_n(&_records[slot].state, FREE, __ATOMIC_RELEASE);
+  }
+};
+
+#endif // OS_ORBIS_ORBIS_THREAD_STACK_REGISTRY_HPP
