+/*
+ * Copyright (c) 2026, OpenOrbis contributors.
+ * SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
+ */
+
+#ifndef OS_ORBIS_SEMAPHORE_ORBIS_HPP
+#define OS_ORBIS_SEMAPHORE_ORBIS_HPP
+
+#include "memory/allocation.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+#include <pthread.h>
+
+// Orbis exposes a semaphore-like kernel API, but the SDK's sem_t layout is
+// not usable by the VM. Keep the well-defined permit semantics in pthread
+// primitives until the native semaphore ABI is independently validated.
+class OrbisSemaphore : public CHeapObj<mtInternal> {
+  pthread_mutex_t _mutex;
+  pthread_cond_t _condition;
+  uint _permits;
+
+  NONCOPYABLE(OrbisSemaphore);
+
+ public:
+  OrbisSemaphore(uint value = 0);
+  ~OrbisSemaphore();
+
+  void signal(uint count = 1);
+  void wait();
+  bool trywait();
+  bool timedwait(int64_t millis);
+};
+
+typedef OrbisSemaphore SemaphoreImpl;
+
+#endif // OS_ORBIS_SEMAPHORE_ORBIS_HPP
